@{
    Layout = "_Layout";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<div class="admin-layout">
    <!-- Sidebar -->
    <aside class="admin-sidebar">
        <div class="admin-sidebar-brand">
            <a asp-controller="Admin" asp-action="Index">
                <i class="fas fa-shield-alt"></i> Админ-панель
            </a>
        </div>
        <nav class="admin-sidebar-nav">
            <div class="admin-sidebar-section">Обзор</div>
            <a class="admin-sidebar-item @(currentAction == "Index" ? "active" : "")" asp-controller="Admin" asp-action="Index">
                <i class="fas fa-chart-pie"></i>
                <span>Дашборд</span>
            </a>

            <div class="admin-sidebar-section">Управление</div>
            <a class="admin-sidebar-item @(currentAction == "Users" ? "active" : "")" asp-controller="Admin" asp-action="Users">
                <i class="fas fa-users"></i>
                <span>Пользователи</span>
            </a>
            <a class="admin-sidebar-item @(currentAction == "Locations" ? "active" : "")" asp-controller="Admin" asp-action="Locations">
                <i class="fas fa-store"></i>
                <span>Заведения</span>
            </a>
            <a class="admin-sidebar-item @(currentAction == "Pending" ? "active" : "")" asp-controller="Admin" asp-action="Pending">
                <i class="fas fa-clipboard-check"></i>
                <span>Модерация</span>
                @if (ViewBag.PendingCount is int pendingCount && pendingCount > 0)
                {
                    <span class="admin-badge">@pendingCount</span>
                }
            </a>

            <div class="admin-sidebar-section">Справочники</div>
            <a class="admin-sidebar-item @(currentAction == "Fandoms" ? "active" : "")" asp-controller="Admin" asp-action="Fandoms">
                <i class="fas fa-layer-group"></i>
                <span>Фандомы</span>
            </a>
            <a class="admin-sidebar-item @(currentAction == "Categories" ? "active" : "")" asp-controller="Admin" asp-action="Categories">
                <i class="fas fa-tags"></i>
                <span>Категории</span>
            </a>

            <div class="admin-sidebar-section">Аналитика</div>
            <a class="admin-sidebar-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" ? "active" : "")" asp-controller="Report" asp-action="Index">
                <i class="fas fa-chart-bar"></i>
                <span>Отчёты</span>
            </a>

            <div class="admin-sidebar-section">Система</div>
            <a class="admin-sidebar-item @(currentAction == "Settings" ? "active" : "")" asp-controller="Admin" asp-action="Settings">
                <i class="fas fa-cog"></i>
                <span>Настройки</span>
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="admin-content">
        @RenderBody()
    </main>
</div>

@section Styles {
    <style>
        .admin-layout {
            display: flex;
            min-height: calc(100vh - 72px);
        }

        .admin-sidebar {
            width: 260px;
            min-width: 260px;
            background: #111;
            color: #fff;
            display: flex;
            flex-direction: column;
            position: sticky;
            top: 72px;
            height: calc(100vh - 72px);
            overflow-y: auto;
        }

        .admin-sidebar-brand {
            padding: 20px 24px;
            border-bottom: 1px solid #222;
        }

        .admin-sidebar-brand a {
            color: #fff;
            font-family: 'Montserrat', sans-serif;
            font-weight: 800;
            font-size: 1.1rem;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .admin-sidebar-brand a:hover {
            color: #fff;
        }

        .admin-sidebar-brand i {
            color: #fff;
        }

        .admin-sidebar-nav {
            padding: 16px 0;
            flex: 1;
        }

        .admin-sidebar-section {
            padding: 16px 24px 6px;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: #666;
            font-weight: 600;
        }

        .admin-sidebar-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 24px;
            color: #999;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.15s ease;
            border-left: 3px solid transparent;
        }

        .admin-sidebar-item:hover {
            color: #fff;
            background: #1a1a1a;
        }

        .admin-sidebar-item.active {
            color: #fff;
            background: #1a1a1a;
            border-left-color: #fff;
            font-weight: 600;
        }

        .admin-sidebar-item i {
            width: 20px;
            text-align: center;
            font-size: 0.95rem;
        }

        .admin-badge {
            margin-left: auto;
            background: #DC3545;
            color: #fff;
            font-size: 0.7rem;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 10px;
        }

        .admin-content {
            flex: 1;
            padding: 32px;
            background: var(--color-bg);
            overflow-y: auto;
        }

        .admin-page-header {
            margin-bottom: 28px;
        }

        .admin-page-header h1 {
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--color-black);
            margin: 0 0 4px;
        }

        .admin-page-header p {
            color: var(--color-secondary);
            font-size: 0.9rem;
            margin: 0;
        }

        /* Stats grid */
        .admin-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 16px;
            margin-bottom: 32px;
        }

        .admin-stat-card {
            background: #fff;
            border: 1px solid var(--color-border);
            border-radius: 12px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .admin-stat-card .stat-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: var(--color-black);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            margin-bottom: 8px;
        }

        .admin-stat-card .stat-value {
            font-family: 'Montserrat', sans-serif;
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--color-black);
            line-height: 1;
        }

        .admin-stat-card .stat-label {
            font-size: 0.8rem;
            color: var(--color-secondary);
        }

        /* Two-column layout */
        .admin-two-col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
        }

        .admin-two-col .card {
            height: 100%;
        }

        /* Role badges */
        .role-admin { background: var(--color-black) !important; color: #fff !important; }
        .role-partner { background: #666 !important; color: #fff !important; }
        .role-tourist { background: #f5f5f5 !important; color: #333 !important; border: 1px solid #e0e0e0; }

        .admin-empty-state {
            text-align: center;
            padding: 48px 24px;
            color: var(--color-secondary);
        }

        .admin-empty-state i {
            font-size: 3rem;
            margin-bottom: 16px;
            display: block;
            opacity: 0.3;
        }

        .admin-empty-state h4 {
            font-size: 1.1rem;
            margin-bottom: 4px;
        }

        .admin-empty-state p {
            font-size: 0.85rem;
        }

        /* Quick actions */
        .admin-quick-actions {
            display: flex;
            gap: 12px;
            margin-bottom: 28px;
            flex-wrap: wrap;
        }

        .admin-quick-actions .btn {
            height: 40px;
            font-size: 0.85rem;
        }

        /* Admin table row highlight */
        .admin-table tbody tr {
            transition: background-color 0.15s ease, box-shadow 0.15s ease;
        }
        .admin-table tbody tr:hover {
            background-color: #FFF8E7 !important;
            box-shadow: inset 3px 0 0 0 #E6A817;
        }

        /* Gold stars in admin */
        .admin-table .rating-stars .fa-star.fas,
        .admin-table .rating-stars .fa-star:not(.far) {
            color: #E6A817;
            -webkit-text-stroke: 1px #C8920C;
        }
        .admin-table .rating-stars .fa-star.far {
            color: transparent;
            -webkit-text-stroke: 1px #CCC;
        }

        @@media (max-width: 991.98px) {
            .admin-layout { flex-direction: column; }
            .admin-sidebar {
                width: 100%;
                min-width: auto;
                position: static;
                height: auto;
            }
            .admin-sidebar-nav {
                display: flex;
                flex-wrap: wrap;
                gap: 4px;
                padding: 12px 16px;
            }
            .admin-sidebar-section { display: none; }
            .admin-sidebar-item {
                padding: 8px 14px;
                border-left: none;
                border-radius: 8px;
                font-size: 0.85rem;
            }
            .admin-sidebar-item.active {
                border-left-color: transparent;
                background: var(--color-black);
                color: #fff;
            }
            .admin-content { padding: 20px; }
            .admin-two-col { grid-template-columns: 1fr; }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
}

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
