@model List<GeekTour.Web.Models.ViewModels.AdminUserViewModel>
@using GeekTour.Web.Models.Enums
@{
    ViewData["Title"] = "Пользователи";
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
}

<div class="admin-page-header">
    <h1>Управление пользователями</h1>
    <p>Всего: @Model.Count пользователей</p>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 admin-table">
                <thead>
                    <tr>
                        <th>Пользователь</th>
                        <th>Роль</th>
                        <th>Компания</th>
                        <th>Статус</th>
                        <th>Регистрация</th>
                        <th>Заведения</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var user in Model)
                        {
                            <tr id="user-row-@user.Id">
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="header-user-avatar" style="width:32px;height:32px;font-size:0.75rem;">
                                            @user.Name.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-semibold" id="user-name-@user.Id">@user.Name</div>
                                            <div class="small text-muted" id="user-email-@user.Id">@user.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge role-@user.Role.ToString().ToLower()" id="user-role-badge-@user.Id">@GetRoleDisplayName(user.Role)</span>
                                </td>
                                <td id="user-company-@user.Id">@(user.CompanyName ?? "—")</td>
                                <td>
                                    @if (user.IsVerified)
                                    {
                                        <span class="badge bg-dark" id="user-verified-@user.Id"><i class="fas fa-check me-1"></i>Верифицирован</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:#f5f5f5;color:#666;border:1px solid #e0e0e0;" id="user-verified-@user.Id"><i class="fas fa-clock me-1"></i>Ожидает</span>
                                    }
                                </td>
                                <td>@user.RegisteredAt.ToString("dd.MM.yyyy")</td>
                                <td>
                                    @if (user.LocationCount > 0)
                                    {
                                        <span class="fw-bold">@user.LocationCount</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">0</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-dark" title="Редактировать"
                                                onclick="openEditUserModal(@user.Id, '@user.Name', '@user.Email', '@user.Role', '@(user.CompanyName ?? "")', @user.IsVerified.ToString().ToLower())">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        @if (user.Role == UserRole.Partner && !user.IsVerified)
                                        {
                                            <form method="post" asp-action="VerifyPartner" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <button type="submit" class="btn btn-sm btn-dark" title="Верифицировать"><i class="fas fa-user-check"></i></button>
                                            </form>
                                        }
                                        <form method="post" asp-action="DeleteUser" class="d-inline" onsubmit="return confirm('Удалить пользователя @user.Name?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-dark" title="Удалить"><i class="fas fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="admin-empty-state">
                                    <i class="fas fa-users"></i>
                                    <h4>Нет пользователей</h4>
                                    <p>В системе пока не зарегистрировано ни одного пользователя</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Edit User Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-user-edit me-2"></i>Редактирование пользователя</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <form id="editUserForm" method="post" asp-action="UpdateUser">
                @Html.AntiForgeryToken()
                <input type="hidden" name="userId" id="editUserId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="editName" class="form-label fw-bold">Имя</label>
                        <input type="text" class="form-control" id="editName" name="name" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label for="editEmail" class="form-label fw-bold">Email</label>
                        <input type="email" class="form-control" id="editEmail" name="email" required maxlength="256" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="editRole" class="form-label fw-bold">Роль</label>
                            <select class="form-select" id="editRole" name="role" required>
                                @foreach (UserRole role in Enum.GetValues(typeof(UserRole)))
                                {
                                    <option value="@role">@GetRoleDisplayName(role)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="editCompanyName" class="form-label fw-bold">Компания</label>
                            <input type="text" class="form-control" id="editCompanyName" name="companyName" maxlength="200" placeholder="Не указано" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="editIsVerified" name="isVerified" value="true" />
                            <label class="form-check-label fw-bold" for="editIsVerified">Верифицирован</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-dark"><i class="fas fa-save me-1"></i>Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditUserModal(id, name, email, role, companyName, isVerified) {
            document.getElementById('editUserId').value = id;
            document.getElementById('editName').value = name;
            document.getElementById('editEmail').value = email;
            document.getElementById('editRole').value = role;
            document.getElementById('editCompanyName').value = companyName || '';
            document.getElementById('editIsVerified').checked = isVerified;

            var modal = new bootstrap.Modal(document.getElementById('editUserModal'));
            modal.show();
        }
    </script>
}

@functions {
    private string GetRoleDisplayName(UserRole role) => role switch
    {
        UserRole.Admin => "Админ",
        UserRole.Partner => "Партнёр",
        UserRole.Tourist => "Турист",
        _ => role.ToString()
    };
}
