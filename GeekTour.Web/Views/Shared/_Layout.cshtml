<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — GeekTour</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Header -->
    <header class="site-header">
        <div class="header-inner">
            <a class="header-logo" asp-controller="Home" asp-action="Index">
                <i class="fas fa-gamepad"></i> GeekTour
            </a>

            <nav class="header-nav">
                <a class="header-nav-link" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-map"></i> Карта
                </a>
                <a class="header-nav-link" asp-controller="Location" asp-action="Index">
                    <i class="fas fa-store"></i> Заведения
                </a>
                @if (Context.Session.GetInt32("UserId") != null)
                {
                    <a class="header-nav-link" asp-controller="Route" asp-action="Index">
                        <i class="fas fa-route"></i> Маршруты
                    </a>
                    @if (Context.Session.GetString("UserRole") == "Partner")
                    {
                        <a class="header-nav-link" asp-controller="Partner" asp-action="Dashboard">
                            <i class="fas fa-briefcase"></i> Кабинет
                        </a>
                    }
                    @if (Context.Session.GetString("UserRole") == "Admin")
                    {
                        <a class="header-nav-link" asp-controller="Admin" asp-action="Index">
                            <i class="fas fa-cog"></i> Админ
                        </a>
                    }
                }
            </nav>

            <div class="header-actions">
                @if (Context.Session.GetInt32("UserId") != null)
                {
                    <a asp-controller="Profile" asp-action="Index" class="header-user text-decoration-none">
                        <div class="header-user-avatar">
                            @Context.Session.GetString("UserName")?.Substring(0, 1).ToUpper()
                        </div>
                        <span class="header-user-name">@Context.Session.GetString("UserName")</span>
                    </a>
                    <a class="btn btn-outline-dark btn-sm header-logout" asp-controller="Account" asp-action="Logout">
                        <i class="fas fa-sign-out-alt"></i> Выход
                    </a>
                }
                else
                {
                    <a class="btn btn-outline-dark btn-sm" asp-controller="Account" asp-action="Login">
                        <i class="fas fa-sign-in-alt"></i> Вход
                    </a>
                    <a class="btn btn-dark btn-sm" asp-controller="Account" asp-action="Register">
                        <i class="fas fa-user-plus"></i> Регистрация
                    </a>
                }
            </div>

            <!-- Mobile toggle -->
            <button class="header-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <i class="fas fa-bars"></i>
            </button>
        </div>

        <!-- Mobile collapse -->
        <div class="collapse navbar-collapse" id="navbarMain">
            <div class="container">
                <nav class="header-nav-mobile">
                    <a class="header-nav-link" asp-controller="Home" asp-action="Index"><i class="fas fa-map"></i> Карта</a>
                    <a class="header-nav-link" asp-controller="Location" asp-action="Index"><i class="fas fa-store"></i> Заведения</a>
                    @if (Context.Session.GetInt32("UserId") != null)
                    {
                        <a class="header-nav-link" asp-controller="Route" asp-action="Index"><i class="fas fa-route"></i> Маршруты</a>
                        @if (Context.Session.GetString("UserRole") == "Partner")
                        {
                            <a class="header-nav-link" asp-controller="Partner" asp-action="Dashboard"><i class="fas fa-briefcase"></i> Кабинет</a>
                        }
                        @if (Context.Session.GetString("UserRole") == "Admin")
                        {
                            <a class="header-nav-link" asp-controller="Admin" asp-action="Index"><i class="fas fa-cog"></i> Админ</a>
                        }
                        <hr />
                        <a class="header-nav-link" asp-controller="Profile" asp-action="Index"><i class="fas fa-user"></i> Профиль</a>
                        <a class="header-nav-link" asp-controller="Account" asp-action="Logout"><i class="fas fa-sign-out-alt"></i> Выход</a>
                    }
                    else
                    {
                        <hr />
                        <a class="header-nav-link" asp-controller="Account" asp-action="Login"><i class="fas fa-sign-in-alt"></i> Вход</a>
                        <a class="header-nav-link" asp-controller="Account" asp-action="Register"><i class="fas fa-user-plus"></i> Регистрация</a>
                    }
                </nav>
            </div>
        </div>
    </header>

    <main class="site-main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container">
            <div class="footer-inner">
                <div class="footer-brand">
                    <span class="footer-logo"><i class="fas fa-gamepad"></i> GeekTour</span>
                    <span class="footer-tagline">Гид по миру гик-культуры</span>
                </div>
                <div class="footer-copy">&copy; @DateTime.Now.Year GeekTour. Все права защищены.</div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
