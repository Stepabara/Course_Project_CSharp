<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — GeekTour</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="site-header">
        <div class="header-inner">
            <a class="header-logo" href="/Home/Index">
                <i class="fas fa-gamepad"></i> GeekTour
            </a>
            <div class="header-actions">
                @if (Context.Session.GetInt32("UserId") != null)
                {
                    <button type="button" class="header-user-btn" id="headerProfileBtn">
                        <div class="header-user-avatar">
                            @Context.Session.GetString("UserName")?.Substring(0, 1).ToUpper()
                        </div>
                        <span class="header-user-name">@Context.Session.GetString("UserName")</span>
                    </button>
                    <a class="btn btn-outline-dark btn-sm header-logout" asp-controller="Account" asp-action="Logout">
                        <i class="fas fa-sign-out-alt"></i>
                    </a>
                }
            </div>
        </div>
    </header>

    <div class="modal-overlay" id="profileModal">
        <div class="modal-sheet" style="max-width:480px;">
            <button type="button" class="modal-close" id="profileModalClose"><i class="fas fa-times"></i></button>
            <div id="profileModalContent">
                <div class="text-center py-4"><div class="spinner-border text-dark"></div></div>
            </div>
        </div>
    </div>

    <main class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-inner">
                <div class="footer-brand">
                    <span class="footer-logo"><i class="fas fa-gamepad"></i> GeekTour</span>
                    <span class="footer-tagline">Гид по миру гик-культуры</span>
                </div>
                <div class="footer-copy">&copy; @DateTime.Now.Year GeekTour. Все права защищены.</div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/profile-modal.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
