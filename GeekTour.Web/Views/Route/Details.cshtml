@model GeekTour.Web.Models.ViewModels.RouteDetailViewModel
@{
    ViewData["Title"] = Model.Name;
    var shareUrl = !string.IsNullOrEmpty(Model.ShareLink)
        ? $"{Context.Request.Scheme}://{Context.Request.Host}/share/{Model.ShareLink}"
        : "";
}

<div class="container mt-4">
    <!-- Route header -->
    <div class="card mb-4" style="border-radius: 16px; border-color: #E0E0E0;">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h3 class="fw-bold mb-1"><i class="fas fa-route"></i> @Model.Name</h3>
                    <p class="text-muted mb-0">@Model.Description</p>
                </div>
                <label class="d-inline-flex align-items-center gap-2" style="cursor:pointer;">
                    <input type="checkbox" id="isPublicChk" @(Model.IsPublic ? "checked" : "") onchange="togglePublic(@Model.Id)" style="width:18px;height:18px;cursor:pointer;" />
                    <span id="isPublicLabel" class="badge @(Model.IsPublic ? "bg-dark" : "bg-secondary")">
                        <i class="fas @(Model.IsPublic ? "fa-globe" : "fa-lock") me-1"></i>
                        <span id="isPublicText">@(Model.IsPublic ? "Публичный" : "Приватный")</span>
                    </span>
                </label>
                <button type="button" class="btn btn-sm btn-outline-dark" onclick="shareDetailRoute()"><i class="fas fa-share-alt"></i> Поделиться</button>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-sm-6 col-lg-3">
                    <div class="stats-card">
                        <div class="stats-value">@Model.TotalDistanceKm.ToString("F1")</div>
                        <div class="stats-label">км</div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="stats-card">
                        <div class="stats-value">@Model.EstimatedTimeMinutes</div>
                        <div class="stats-label">мин</div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="stats-card">
                        <div class="stats-value">@Model.Points.Count</div>
                        <div class="stats-label">точек</div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="stats-card">
                        <div class="stats-value">@Model.CreatedAt.ToString("dd.MM")</div>
                        <div class="stats-label">@Model.CreatedAt.ToString("yyyy")</div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Route map -->
    @if (Model.Points.Any())
    {
        <div class="card mb-4" style="border-radius: 16px; border-color: #E0E0E0;">
            <div class="card-header bg-white"><h5 class="mb-0"><i class="fas fa-map"></i> Карта маршрута</h5></div>
            <div class="card-body p-0">
                <div id="routeMap" style="height: 400px; border-radius: 0 0 16px 16px;"></div>
            </div>
        </div>
    }

    <!-- Route points -->
    <h4 class="mb-3 fw-bold"><i class="fas fa-list-ol"></i> Точки маршрута</h4>

    @if (Model.Points.Any())
    {
        var orderedPoints = Model.Points.OrderBy(p => p.OrderIndex).ToList();
        <div class="card mb-4" style="border-radius: 16px; border-color: #E0E0E0;">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead style="background: #F5F5F5;">
                            <tr>
                                <th class="text-center ps-3" style="width:50px;">#</th>
                                <th>Название</th>
                                <th>Адрес</th>
                                <th class="text-center">Время</th>
                                <th class="text-center pe-3">Переход</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < orderedPoints.Count; i++)
                            {
                                var point = orderedPoints[i];
                                <tr>
                                    <td class="text-center ps-3"><span class="badge rounded-pill bg-dark">@(i + 1)</span></td>
                                    <td>
                                        <a asp-controller="Location" asp-action="Details" asp-route-id="@point.LocationId" class="text-decoration-none fw-bold text-dark">
                                            <i class="fas fa-map-marker-alt text-muted me-1"></i>@point.LocationName
                                        </a>
                                    </td>
                                    <td class="text-muted">@point.LocationAddress</td>
                                    <td class="text-center">
                                        @if (point.PlannedVisitTime.HasValue)
                                        {
                                            <span class="badge bg-secondary">@point.PlannedVisitTime.Value.ToString("HH:mm")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center pe-3">
                                        @if (point.TravelTimeFromPreviousMinutes > 0)
                                        {
                                            <span class="badge" style="background:#E0E0E0;color:#000;"><i class="fas fa-walking me-1"></i>@point.TravelTimeFromPreviousMinutes мин</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-dark">Старт</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Action buttons -->
    <div class="d-flex gap-2 mb-4 flex-wrap">
        <button type="button" class="btn btn-outline-dark" onclick="goBack()"><i class="fas fa-arrow-left me-1"></i>Назад</button>
        @if (Context.Session.GetInt32("UserId") != null)
        {
            <form asp-controller="Route" asp-action="Optimize" asp-route-routeId="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-dark"><i class="fas fa-magic me-1"></i>Оптимизировать</button>
            </form>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        function goBack() {
            window.history.back();
        }

        function togglePublic(routeId) {
            var chk = document.getElementById('isPublicChk');
            var label = document.getElementById('isPublicLabel');
            var text = document.getElementById('isPublicText');
            var icon = label.querySelector('i');
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            var body = 'routeId=' + routeId + '&isPublic=' + chk.checked;
            if (token) body += '&__RequestVerificationToken=' + encodeURIComponent(token.value);
            fetch('/Route/SetPublic', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body
            }).then(function(r) { return r.json(); })
            .then(function(data) {
                if (data && data.success) {
                    if (chk.checked) {
                        label.className = 'badge bg-dark';
                        icon.className = 'fas fa-globe me-1';
                        text.textContent = 'Публичный';
                    } else {
                        label.className = 'badge bg-secondary';
                        icon.className = 'fas fa-lock me-1';
                        text.textContent = 'Приватный';
                    }
                } else {
                    chk.checked = !chk.checked;
                    alert('Ошибка');
                }
            }).catch(function() {
                chk.checked = !chk.checked;
                alert('Ошибка');
            });
        }

        // Route map
        (function() {
            var mapEl = document.getElementById('routeMap');
            if (!mapEl) return;
            if (typeof L === 'undefined') {
                console.error('Leaflet not loaded');
                return;
            }

            var points = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Points.OrderBy(p => p.OrderIndex).Select(p => new { p.Latitude, p.Longitude, p.LocationName })));

            if (!points || points.length === 0) return;

            var firstPt = points[0];
            var map = L.map('routeMap').setView([firstPt.Latitude, firstPt.Longitude], 13);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap'
            }).addTo(map);

            var latlngs = [];
            points.forEach(function(pt, i) {
                var ll = [pt.Latitude, pt.Longitude];
                latlngs.push(ll);
                L.marker(ll).addTo(map)
                    .bindPopup('<b>#' + (i+1) + '</b><br>' + pt.LocationName);
            });

            if (latlngs.length > 1) {
                L.polyline(latlngs, { color: '#000', weight: 3, opacity: 0.8 }).addTo(map);
                map.fitBounds(L.latLngBounds(latlngs), { padding: [30, 30] });
            }

            setTimeout(function() { map.invalidateSize(); }, 200);
        })();

        // ═══ Share route with coordinates ═══
        var routePoints = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Points.OrderBy(p => p.OrderIndex).Select(p => new { p.Latitude, p.Longitude })));

        function shareDetailRoute() {
            if (!routePoints || routePoints.length === 0) { alert('Нет точек маршрута'); return; }
            var coords = routePoints.map(function(p) { return p.Latitude + ',' + p.Longitude; }).join('~');
            var yandexUrl = 'https://yandex.ru/maps/?rtext=' + coords + '&rtt=auto';
            if (navigator.clipboard) {
                navigator.clipboard.writeText(yandexUrl).then(function() {
                    alert('Ссылка скопирована! ✅');
                });
            } else {
                prompt('Скопируйте ссылку:', yandexUrl);
            }
        }
    </script>
}
