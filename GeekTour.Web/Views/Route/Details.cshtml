@model GeekTour.Web.Models.ViewModels.RouteDetailViewModel
@{
    ViewData["Title"] = Model.Name;
    var shareUrl = !string.IsNullOrEmpty(Model.ShareLink)
        ? $"{Context.Request.Scheme}://{Context.Request.Host}/share/{Model.ShareLink}"
        : "";
}

<div class="container mt-4">
    <!-- Route header -->
    <div class="card mb-4" style="border-radius: 16px; border-color: #E0E0E0;">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h3 class="fw-bold mb-1"><i class="fas fa-route"></i> @Model.Name</h3>
                    <p class="text-muted mb-0">@Model.Description</p>
                </div>
                @if (Model.IsPublic)
                {
                    <span class="badge bg-dark"><i class="fas fa-globe me-1"></i>Публичный</span>
                }
                else
                {
                    <span class="badge bg-secondary"><i class="fas fa-lock me-1"></i>Приватный</span>
                }
            </div>

            <div class="row g-3 mb-3">
                <div class="col-sm-6 col-lg-3">
                    <div class="stats-card">
                        <div class="stats-value">@Model.TotalDistanceKm.ToString("F1")</div>
                        <div class="stats-label">км</div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="stats-card">
                        <div class="stats-value">@Model.EstimatedTimeMinutes</div>
                        <div class="stats-label">мин</div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="stats-card">
                        <div class="stats-value">@Model.Points.Count</div>
                        <div class="stats-label">точек</div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="stats-card">
                        <div class="stats-value">@Model.CreatedAt.ToString("dd.MM")</div>
                        <div class="stats-label">@Model.CreatedAt.ToString("yyyy")</div>
                    </div>
                </div>
            </div>

            <!-- Share section -->
            @if (Model.IsPublic && !string.IsNullOrEmpty(Model.ShareLink))
            {
                <div class="mt-3 p-3" style="background: #F5F5F5; border-radius: 12px;">
                    <strong><i class="fas fa-share-alt me-1"></i>Поделиться маршрутом</strong>
                    <div class="input-group mt-2">
                        <input type="text" class="form-control" id="shareLink" value="@shareUrl" readonly />
                        <button class="btn btn-outline-dark" type="button" onclick="copyShareLink()"><i class="fas fa-copy"></i></button>
                    </div>
                    <div class="d-flex gap-2 mt-2">
                        <a href="https://t.me/share/url?url=@Uri.EscapeDataString(shareUrl)&text=@Uri.EscapeDataString(Model.Name)" target="_blank" class="btn btn-sm btn-outline-dark"><i class="fab fa-telegram"></i> Telegram</a>
                        <a href="https://vk.com/share.php?url=@Uri.EscapeDataString(shareUrl)&title=@Uri.EscapeDataString(Model.Name)" target="_blank" class="btn btn-sm btn-outline-dark"><i class="fab fa-vk"></i> VK</a>
                        <a href="https://www.facebook.com/sharer/sharer.php?u=@Uri.EscapeDataString(shareUrl)" target="_blank" class="btn btn-sm btn-outline-dark"><i class="fab fa-facebook"></i> Facebook</a>
                        <a href="https://twitter.com/intent/tweet?url=@Uri.EscapeDataString(shareUrl)&text=@Uri.EscapeDataString(Model.Name)" target="_blank" class="btn btn-sm btn-outline-dark"><i class="fab fa-twitter"></i> Twitter</a>
                        <a href="mailto:?subject=@Uri.EscapeDataString(Model.Name)&body=@Uri.EscapeDataString(shareUrl)" class="btn btn-sm btn-outline-dark"><i class="fas fa-envelope"></i> Email</a>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Route map -->
    @if (Model.Points.Any())
    {
        <div class="card mb-4" style="border-radius: 16px; border-color: #E0E0E0;">
            <div class="card-header bg-white"><h5 class="mb-0"><i class="fas fa-map"></i> Карта маршрута</h5></div>
            <div class="card-body p-0">
                <div id="routeMap" style="height: 400px; border-radius: 0 0 16px 16px;"></div>
            </div>
        </div>
    }

    <!-- Route points -->
    <h4 class="mb-3 fw-bold"><i class="fas fa-list-ol"></i> Точки маршрута</h4>

    @if (Model.Points.Any())
    {
        var orderedPoints = Model.Points.OrderBy(p => p.OrderIndex).ToList();
        <div class="card mb-4" style="border-radius: 16px; border-color: #E0E0E0;">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead style="background: #F5F5F5;">
                            <tr>
                                <th class="text-center ps-3" style="width:50px;">#</th>
                                <th>Название</th>
                                <th>Адрес</th>
                                <th class="text-center">Время</th>
                                <th class="text-center pe-3">Переход</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < orderedPoints.Count; i++)
                            {
                                var point = orderedPoints[i];
                                <tr>
                                    <td class="text-center ps-3"><span class="badge rounded-pill bg-dark">@(i + 1)</span></td>
                                    <td>
                                        <a asp-controller="Location" asp-action="Details" asp-route-id="@point.LocationId" class="text-decoration-none fw-bold text-dark">
                                            <i class="fas fa-map-marker-alt text-muted me-1"></i>@point.LocationName
                                        </a>
                                    </td>
                                    <td class="text-muted">@point.LocationAddress</td>
                                    <td class="text-center">
                                        @if (point.PlannedVisitTime.HasValue)
                                        {
                                            <span class="badge bg-secondary">@point.PlannedVisitTime.Value.ToString("HH:mm")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center pe-3">
                                        @if (point.TravelTimeFromPreviousMinutes > 0)
                                        {
                                            <span class="badge" style="background:#E0E0E0;color:#000;"><i class="fas fa-walking me-1"></i>@point.TravelTimeFromPreviousMinutes мин</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-dark">Старт</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Action buttons -->
    <div class="d-flex gap-2 mb-4 flex-wrap">
        <a asp-controller="Route" asp-action="Index" class="btn btn-outline-dark"><i class="fas fa-arrow-left me-1"></i>Назад</a>
        @if (Context.Session.GetInt32("UserId") != null)
        {
            <form asp-controller="Route" asp-action="Optimize" asp-route-routeId="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-dark"><i class="fas fa-magic me-1"></i>Оптимизировать</button>
            </form>
        }
        @if (!Model.IsPublic || string.IsNullOrEmpty(Model.ShareLink))
        {
            <form asp-controller="Route" asp-action="Share" asp-route-routeId="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-dark"><i class="fas fa-share-alt me-1"></i>Сделать публичным</button>
            </form>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        function copyShareLink() {
            var copyText = document.getElementById("shareLink");
            copyText.select();
            copyText.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(copyText.value);
            var btn = copyText.nextElementSibling;
            btn.innerHTML = '<i class="fas fa-check"></i>';
            setTimeout(function () { btn.innerHTML = '<i class="fas fa-copy"></i>'; }, 2000);
        }

        // Route map
        @if (Model.Points.Any())
        {
            <text>
            (function() {
                var mapEl = document.getElementById('routeMap');
                if (!mapEl) return;
                if (typeof L === 'undefined') {
                    console.error('Leaflet not loaded');
                    return;
                }

                var points = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Points.OrderBy(p => p.OrderIndex).Select(p => new { p.Latitude, p.Longitude, p.LocationName })));

                if (!points || points.length === 0) return;

                var firstPt = points[0];
                var map = L.map('routeMap').setView([firstPt.Latitude, firstPt.Longitude], 13);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; OpenStreetMap'
                }).addTo(map);

                var latlngs = [];
                points.forEach(function(pt, i) {
                    var ll = [pt.Latitude, pt.Longitude];
                    latlngs.push(ll);
                    L.marker(ll).addTo(map)
                        .bindPopup('<b>#' + (i+1) + '</b><br>' + pt.LocationName);
                });

                if (latlngs.length > 1) {
                    L.polyline(latlngs, { color: '#000', weight: 3, opacity: 0.8 }).addTo(map);
                    map.fitBounds(L.latLngBounds(latlngs), { padding: [30, 30] });
                }

                // Force map to recalculate size after render
                setTimeout(function() { map.invalidateSize(); }, 100);
            })();
            </text>
        }
    </script>
}
