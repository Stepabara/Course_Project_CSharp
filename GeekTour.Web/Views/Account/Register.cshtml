@model GeekTour.Web.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Регистрация";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <i class="fas fa-user-plus"></i>
            <h2>Регистрация</h2>
            <p class="text-muted">Создайте аккаунт в GeekTour</p>
        </div>

        <form asp-controller="Account" asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Имя</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-user"></i></span>
                    <input asp-for="Name" class="form-control" placeholder="Введите ваше имя" />
                </div>
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                    <input asp-for="Email" class="form-control" placeholder="example@mail.ru" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Пароль</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                    <input asp-for="Password" class="form-control" placeholder="Минимум 6 символов" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Подтверждение пароля</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Повторите пароль" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsPartner" class="form-check-input" id="isPartnerCheck" />
                <label asp-for="IsPartner" class="form-check-label">Регистрация как партнёр</label>
            </div>

            <div id="partnerFields" style="display: none;">
                <div class="mb-3">
                    <label asp-for="CompanyName" class="form-label">Название компании</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-building"></i></span>
                        <input asp-for="CompanyName" class="form-control" placeholder="Название вашей компании" />
                    </div>
                    <span asp-validation-for="CompanyName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="INN" class="form-label">ИНН</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-file-invoice"></i></span>
                        <input asp-for="INN" class="form-control" placeholder="ИНН компании" maxlength="12" />
                    </div>
                    <span asp-validation-for="INN" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-dark btn-lg">
                    <i class="fas fa-user-plus"></i> Зарегистрироваться
                </button>
            </div>
        </form>

        <hr />

        <div class="text-center">
            <p class="mb-0 text-muted">
                Уже есть аккаунт?
                <a asp-controller="Account" asp-action="Login" class="fw-bold">Войти</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('isPartnerCheck').addEventListener('change', function () {
            document.getElementById('partnerFields').style.display = this.checked ? 'block' : 'none';
        });
    </script>
}
