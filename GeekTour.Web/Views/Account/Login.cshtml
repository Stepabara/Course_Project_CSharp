@model GeekTour.Web.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Вход";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-header">
            <i class="fas fa-sign-in-alt"></i>
            <h2>Вход в аккаунт</h2>
            <p class="text-muted">Войдите в систему GeekTour</p>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                    <input asp-for="Email" class="form-control" placeholder="example@mail.ru" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Пароль</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                    <input asp-for="Password" class="form-control" placeholder="Введите пароль" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">Запомнить меня</label>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-dark btn-lg">
                    <i class="fas fa-sign-in-alt"></i> Войти
                </button>
            </div>
        </form>

        <hr />

        <div class="text-center">
            <p class="mb-0 text-muted">
                Нет аккаунта?
                <a asp-controller="Account" asp-action="Register" class="fw-bold">Зарегистрироваться</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
