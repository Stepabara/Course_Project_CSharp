@model List<GeekTour.Web.Models.ViewModels.LocationListViewModel>
@using GeekTour.Web.Models.Entities
@using GeekTour.Web.Models.Enums
@{
    ViewData["Title"] = "Главная";
    var allFandoms = ViewBag.Fandoms as List<Fandom> ?? new List<Fandom>();
    var allCategories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var isAuthenticated = Context.Session.GetInt32("UserId") != null;
}

@Html.AntiForgeryToken()

<div class="home-layout">
    <!-- ═══ Sidebar Toggle Button (always visible on Map tab) ═══ -->
    <button type="button" class="sidebar-toggle-btn" id="sidebarToggleBtn" onclick="toggleSidebar()" title="Скрыть/показать фильтры">
        <i class="fas fa-chevron-left" id="sidebarToggleIcon"></i>
    </button>

    <!-- ═══ Left Sidebar: Filters (only for Map tab) ═══ -->
    <aside class="home-sidebar tab-map-sidebar" id="homeSidebar">
        <div class="home-sidebar-header">
            <h5><i class="fas fa-filter"></i> Фильтры</h5>
            <button type="button" class="btn btn-sm btn-outline-dark" id="sidebarResetBtn" onclick="resetAllFilters()" style="display:none;">
                <i class="fas fa-times"></i> Сбросить
            </button>
        </div>

        <div class="home-filters-scroll">
            <!-- Search -->
            <div class="home-filter-group">
                <label class="form-label">Поиск</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" id="searchInput" class="form-control" placeholder="Название, адрес..."
                           value="@Context.Request.Query["SearchQuery"]" />
                </div>
            </div>

            <!-- Type filter -->
            <div class="home-filter-group">
                <label class="form-label">Тип</label>
                <select id="typeFilter" class="form-select">
                    <option value="" selected>Все типы</option>
                    @foreach (var t in Enum.GetValues<LocationType>())
                    {
                        <option value="@((int)t)">@GetLocationTypeName(t)</option>
                    }
                </select>
            </div>

            <!-- Fandom checkboxes -->
            <div class="home-filter-group">
                <label class="form-label">Фандом</label>
                <div class="fandom-checkboxes">
                    @foreach (var fandom in allFandoms)
                    {
                        <div class="form-check">
                            <input class="form-check-input fandom-checkbox" type="checkbox" value="@fandom.Id"
                                   id="fandom_@fandom.Id" onchange="applyFilters()" />
                            <label class="form-check-label" for="fandom_@fandom.Id">
                                @GetFandomEmoji(fandom.Category) @fandom.Name
                            </label>
                        </div>
                    }
                </div>
            </div>

            <!-- Category filter -->
            <div class="home-filter-group">
                <label class="form-label">Категория</label>
                <select id="categoryFilter" class="form-select">
                    <option value="" selected>Все категории</option>
                    @foreach (var cat in allCategories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </select>
            </div>

            <!-- Rating filter -->
            <div class="home-filter-group">
                <label class="form-label">Мин. рейтинг</label>
                <select id="ratingFilter" class="form-select">
                    <option value="" selected>Любой</option>
                    <option value="4">4+</option>
                    <option value="4.5">4.5+</option>
                </select>
            </div>

            <!-- Sort -->
            <div class="home-filter-group">
                <label class="form-label">Сортировка</label>
                <select id="sortFilter" class="form-select">
                    <option value="rating">По рейтингу</option>
                    <option value="name">По названию</option>
                    <option value="newest">Новые</option>
                </select>
            </div>
        </div>

        <div class="home-sidebar-footer">
            <button type="button" class="btn btn-dark w-100" onclick="applyFilters()">
                <i class="fas fa-search"></i> Применить
            </button>
        </div>
    </aside>

    <!-- ═══ Main Content Area ═══ -->
    <div class="home-content">
        <!-- Tab: Map -->
        <div class="home-tab-content active" id="tab-map">
            <div class="home-map">
                <div id="map"></div>
                <div class="home-map-counter">
                    <span class="badge bg-dark" id="locCount">@Model.Count</span> заведений
                </div>
            </div>
        </div>

        <!-- Tab: Planner -->
        <div class="home-tab-content" id="tab-planner">
            <div class="planner-container">
                <!-- Planner sub-tabs -->
                <ul class="nav nav-tabs mb-3" id="plannerTabs">
                    <li class="nav-item">
                        <button type="button" class="nav-link active" data-planner-tab="calendar" onclick="switchPlannerTab('calendar')">
                            <i class="fas fa-calendar-alt"></i> Календарь
                        </button>
                    </li>
                    <li class="nav-item">
                        <button type="button" class="nav-link" data-planner-tab="myroutes" onclick="switchPlannerTab('myroutes')">
                            <i class="fas fa-route"></i> Мои маршруты
                        </button>
                    </li>
                    <li class="nav-item">
                        <button type="button" class="nav-link" data-planner-tab="public" onclick="switchPlannerTab('public')">
                            <i class="fas fa-globe"></i> Публичные маршруты
                        </button>
                    </li>
                </ul>

                <!-- Calendar sub-tab -->
                <div class="planner-sub-tab active" id="planner-tab-calendar">
                    <div class="row g-3">
                        <div class="col-lg-5">
                            <div class="card planner-card">
                                <div class="card-header">
                                    <h5 class="mb-0"><i class="fas fa-calendar-alt"></i> Календарь</h5>
                                </div>
                                <div class="card-body p-3">
                                    <div id="plannerCalendar">
                                        <div class="calendar-header">
                                            <button type="button" class="btn btn-sm btn-outline-dark" onclick="calendarPrev()"><i class="fas fa-chevron-left"></i></button>
                                            <span id="calendarMonthYear" class="calendar-month-year"></span>
                                            <button type="button" class="btn btn-sm btn-outline-dark" onclick="calendarNext()"><i class="fas fa-chevron-right"></i></button>
                                        </div>
                                        <div class="calendar-grid">
                                            <div class="calendar-day-name">Пн</div><div class="calendar-day-name">Вт</div><div class="calendar-day-name">Ср</div>
                                            <div class="calendar-day-name">Чт</div><div class="calendar-day-name">Пт</div><div class="calendar-day-name">Сб</div><div class="calendar-day-name">Вс</div>
                                        </div>
                                        <div class="calendar-grid" id="calendarDays"></div>
                                    </div>
                                    <div class="mt-3"><small class="text-muted"><i class="fas fa-info-circle"></i> Выберите дату, чтобы увидеть запланированные точки</small></div>
                                </div>
                            </div>
                            <div class="card planner-card mt-3">
                                <div class="card-body">
                                    <h6><i class="fas fa-clock"></i> Выбранная дата: <span id="selectedDateDisplay" class="text-muted">не выбрана</span></h6>
                                    <div id="dayPointsList" class="mt-2"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-7">
                            <div class="card planner-card">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0"><i class="fas fa-list"></i> Запланированные точки</h5>
                                    <span class="badge bg-dark" id="plannerCount">0</span>
                                </div>
                                <div class="card-body p-0">
                                    <div id="plannerList" class="planner-list">
                                        <div class="text-center py-5 text-muted" id="plannerEmpty">
                                            <i class="fas fa-calendar-plus fa-2x mb-2"></i>
                                            <p class="mb-0">Нажмите <i class="fas fa-calendar"></i> на карте, чтобы добавить точку</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex gap-2 mt-3">
                                <button type="button" class="btn btn-dark flex-fill" id="buildRouteBtn" onclick="buildRouteFromPlanner()" disabled>
                                    <i class="fas fa-route"></i> Построить маршрут
                                </button>
                                <button type="button" class="btn btn-outline-dark" onclick="clearPlanner()" title="Очистить"><i class="fas fa-trash"></i></button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- My Routes sub-tab -->
                <div class="planner-sub-tab" id="planner-tab-myroutes">
                    <div class="card planner-card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0"><i class="fas fa-route"></i> Мои маршруты</h5>
                            <span class="badge bg-dark" id="myRoutesCount">0</span>
                        </div>
                        <div class="card-body p-0">
                            <div id="myRoutesFeed" class="profile-routes-feed" style="max-height:400px;overflow-y:auto;">
                                <div class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm"></div><p class="mt-2 mb-0">Загрузка...</p></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Public Routes sub-tab -->
                <div class="planner-sub-tab" id="planner-tab-public">
                    <div class="card planner-card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0"><i class="fas fa-globe"></i> Публичные маршруты</h5>
                            <span class="badge bg-dark" id="publicRoutesCount">0</span>
                        </div>
                        <div class="card-body p-0">
                            <div id="publicRoutesFeed" class="profile-routes-feed" style="max-height:400px;overflow-y:auto;">
                                <div class="text-center py-4 text-muted"><div class="spinner-border spinner-border-sm"></div><p class="mt-2 mb-0">Загрузка...</p></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ Route Detail Modal ═══ -->
        <div class="modal-overlay" id="routeModal">
            <div class="modal-sheet" style="max-width:560px;">
                <button type="button" class="modal-close" onclick="closeRouteModal()"><i class="fas fa-times"></i></button>
                <div id="routeModalContent">
                    <div class="text-center py-4"><div class="spinner-border text-dark"></div></div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- ═══ Location Modal ═══ -->
<div class="loc-sheet-overlay" id="locSheetOverlay" onclick="if(event.target===this)closeLocSheet()">
    <div class="loc-sheet" id="locSheet">
        <div id="locSheetContent">
            <!-- Content loaded dynamically -->
        </div>
    </div>
</div>

<!-- Loading overlay -->
<div id="loadingOverlay" style="display:none;position:fixed;top:72px;left:0;right:0;bottom:0;background:rgba(255,255,255,0.7);z-index:999;align-items:center;justify-content:center;">
    <div class="spinner-border text-dark" role="status">
        <span class="visually-hidden">Загрузка...</span>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var isAuthenticated = @isAuthenticated.ToString().ToLower();

        // ═══ Map initialization — Минск ═══
        var map = L.map('map').setView([53.9045, 27.5615], 12);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap'
        }).addTo(map);

        var markers = [];
        var markerMap = {};
        var allLocations = [];

        // ═══ Type helpers ═══
        function typeEmoji(type) { return type === 0 ? '🍜' : type === 1 ? '🛒' : '🎨'; }
        function typeName(type) { return type === 0 ? 'Кафе' : type === 1 ? 'Магазин' : 'Арт-объект'; }

        // ═══ Fandom category colors for markers ═══
        function getMarkerColor(type) {
            if (type === 0) return '#6C5CE7';
            if (type === 1) return '#00B894';
            return '#E17055';
        }

        function createColoredIcon(type) {
            var color = getMarkerColor(type);
            return L.divIcon({
                className: 'custom-marker',
                html: '<div style="background:' + color + ';width:28px;height:28px;border-radius:50%;border:3px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,0.3);display:flex;align-items:center;justify-content:center;font-size:12px;">' + typeEmoji(type) + '</div>',
                iconSize: [28, 28],
                iconAnchor: [14, 14],
                popupAnchor: [0, -16]
            });
        }

        // ═══ Working hours parser ═══
        function parseWorkingHours(json) {
            try {
                var h = JSON.parse(json);
                var days = ['monday','tuesday','wednesday','thursday','friday','saturday','sunday'];
                var names = ['Пн','Вт','Ср','Чт','Пт','Сб','Вс'];
                var result = '';
                for (var i = 0; i < 7; i++) {
                    var v = h[days[i]];
                    if (v) {
                        if (v === 'closed') result += names[i] + ': закрыто<br>';
                        else result += names[i] + ': ' + v + '<br>';
                    }
                }
                return result || 'Не указано';
            } catch(e) { return 'Не указано'; }
        }

        function getTodayHours(json) {
            try {
                var h = JSON.parse(json);
                var days = ['sunday','monday','tuesday','wednesday','thursday','friday','saturday'];
                var today = days[new Date().getDay()];
                var v = h[today];
                if (!v) return 'Не указано';
                if (v === 'closed') return 'Закрыто';
                return v;
            } catch(e) { return 'Не указано'; }
        }

        // ═══ Auth gate helper ═══
        function requireAuth(action) {
            if (isAuthenticated) return true;
            // Show auth prompt modal
            showAuthPrompt(action);
            return false;
        }

        function showAuthPrompt(action) {
            var sheet = document.getElementById('locSheetOverlay');
            var content = document.getElementById('locSheetContent');
            content.innerHTML =
                '<div class="loc-sheet-handle"></div>' +
                '<div style="padding:40px 20px;text-align:center;">' +
                    '<i class="fas fa-lock fa-3x text-muted mb-3"></i>' +
                    '<h4 style="font-family:var(--font-heading);font-weight:700;">Требуется авторизация</h4>' +
                    '<p class="text-muted mb-4">Чтобы использовать функцию «' + action + '», войдите в свой аккаунт или зарегистрируйтесь.</p>' +
                    '<a href="/Account/Login" class="btn btn-dark btn-lg me-2"><i class="fas fa-sign-in-alt"></i> Войти</a>' +
                    '<a href="/Account/Register" class="btn btn-outline-dark btn-lg"><i class="fas fa-user-plus"></i> Регистрация</a>' +
                '</div>';
            sheet.classList.add('open');
        }

        // ═══ Build rich popup ═══
        function buildPopup(loc) {
            var id = loc.id || loc.Id;
            var name = loc.name || loc.Name;
            var type = loc.type !== undefined ? loc.type : loc.Type;
            var rating = loc.averageRating !== undefined ? loc.averageRating : loc.AverageRating;
            var desc = (loc.description || loc.Description || '').substring(0, 120);
            var addr = loc.address || loc.Address || '';
            var fandoms = loc.fandomNames || loc.FandomNames || [];
            var img = loc.mainImagePath || loc.MainImagePath;
            var wh = loc.workingHoursJson || loc.WorkingHoursJson || '{}';
            var todayWh = getTodayHours(wh);

            var starsHtml = '';
            for (var i = 1; i <= 5; i++) {
                starsHtml += '<i class="fa-star ' + (i <= Math.round(rating) ? 'fas' : 'far') + '" style="color:#FFC107;font-size:0.8rem;"></i>';
            }

            var fandomsHtml = fandoms.length > 0
                ? '<div style="margin:4px 0;">' + fandoms.map(function(f) {
                    return '<span class="badge bg-secondary me-1" style="font-size:0.7rem;">' + f + '</span>';
                }).join('') + '</div>'
                : '';

            var imgHtml = img
                ? '<div style="margin-bottom:8px;"><img src="' + img + '" style="width:100%;height:80px;object-fit:cover;border-radius:6px;" alt="" onerror="this.style.display=\'none\'" /></div>'
                : '<div style="margin-bottom:8px;background:#f0f0f0;height:60px;border-radius:6px;display:flex;align-items:center;justify-content:center;color:#999;font-size:0.75rem;">' + typeEmoji(type) + ' ' + typeName(type) + '</div>';

            // Guest: show buttons but they trigger auth prompt
            var plannerBtn = isAuthenticated
                ? '<button type="button" class="btn btn-sm btn-dark" onclick="addToPlannerFromMap(' + id + ',\'' + name.replace(/'/g, "\\'") + '\')"><i class="fas fa-calendar-plus"></i> В планер</button>'
                : '<button type="button" class="btn btn-sm btn-dark" onclick="requireAuth(\'Добавить в планер\')"><i class="fas fa-calendar-plus"></i> В планер</button>';
            var reviewBtn = isAuthenticated
                ? '<button type="button" class="btn btn-sm btn-outline-dark" onclick="writeReview(' + id + ')"><i class="fas fa-pen"></i></button>'
                : '<button type="button" class="btn btn-sm btn-outline-dark" onclick="requireAuth(\'Написать отзыв\')"><i class="fas fa-pen"></i></button>';

            return '<div class="map-popup" style="min-width:220px;max-width:260px;">' +
                imgHtml +
                '<b style="font-size:0.95rem;">' + typeEmoji(type) + ' ' + name + '</b><br>' +
                '<div style="margin:2px 0;">' + starsHtml + ' <span style="font-size:0.8rem;color:#666;">' + Number(rating).toFixed(1) + '</span></div>' +
                fandomsHtml +
                '<div style="font-size:0.78rem;color:#666;margin:4px 0;">📍 ' + addr + '</div>' +
                '<div style="font-size:0.78rem;color:#666;margin:2px 0;">🕐 Сегодня: ' + todayWh + '</div>' +
                (desc ? '<div style="font-size:0.78rem;color:#888;margin:4px 0;">' + desc + (desc.length >= 120 ? '...' : '') + '</div>' : '') +
                '<div style="margin-top:10px;display:flex;gap:4px;flex-wrap:wrap;">' +
                    plannerBtn + reviewBtn +
                    '<button type="button" class="btn btn-sm btn-outline-dark" onclick="openLocationModal(' + id + ')" title="Подробнее"><i class="fas fa-info"></i></button>' +
                '</div></div>';
        }

        // ═══ Markers management ═══
        function clearMarkers() {
            markers.forEach(function(m) { map.removeLayer(m); });
            markers = [];
            markerMap = {};
        }

        function addMarkers(locations) {
            clearMarkers();
            var bounds = L.latLngBounds();
            var count = 0;
            locations.forEach(function(loc) {
                var lat = loc.latitude || loc.Latitude;
                var lng = loc.longitude || loc.Longitude;
                if (!lat || !lng) return;
                var type = loc.type !== undefined ? loc.type : loc.Type;
                var marker = L.marker([lat, lng], { icon: createColoredIcon(type) })
                    .addTo(map);
                marker.on('click', function() {
                    openLocationModal(loc.id || loc.Id);
                });
                markers.push(marker);
                markerMap[loc.id || loc.Id] = marker;
                bounds.extend([lat, lng]);
                count++;
            });
            if (markers.length > 0) map.fitBounds(bounds, { padding: [40, 40] });
            else map.setView([53.9045, 27.5615], 12);
            return count;
        }

        function focusLocation(id, lat, lng) {
            map.setView([lat, lng], 15);
            openLocationModal(id);
        }

        // ═══ Load initial locations ═══
        allLocations = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(l => new { l.Id, l.Name, l.Description, l.Address, l.Latitude, l.Longitude, l.AverageRating, l.Type, l.FandomIds, l.FandomNames, l.WorkingHoursJson, l.MainImagePath })));
        addMarkers(allLocations);

        // ═══ Location Bottom Sheet ═══
        var currentLocId = null;
        var currentLocData = null;

        function openLocationModal(id) {
            currentLocId = id;
            var loc = findLoc(id);
            if (!loc) {
                fetch('/Location/GetLocationData?id=' + id)
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        if (data) renderLocSheet(data);
                    });
                return;
            }
            renderLocSheet(loc);
        }

        function renderLocSheet(loc) {
            var id = loc.id || loc.Id;
            var name = loc.name || loc.Name;
            var type = loc.type !== undefined ? loc.type : loc.Type;
            var rating = loc.averageRating !== undefined ? loc.averageRating : loc.AverageRating;
            var desc = loc.description || loc.Description || '';
            var addr = loc.address || loc.Address || '';
            var fandoms = loc.fandomNames || loc.FandomNames || [];
            var img = loc.mainImagePath || loc.MainImagePath;
            var wh = loc.workingHoursJson || loc.WorkingHoursJson || '{}';
            var reviewCount = loc.reviewCount !== undefined ? loc.reviewCount : loc.ReviewCount || 0;
            var catName = loc.categoryName || loc.CategoryName || '';
            currentLocData = loc;

            // Stars
            var starsHtml = '';
            for (var i = 1; i <= 5; i++) {
                starsHtml += '<i class="fa-star ' + (i <= Math.round(rating) ? 'fas' : 'far') + '" style="color:#FFC107;"></i>';
            }

            // Fandoms
            var fandomsHtml = fandoms.length > 0
                ? '<div class="loc-fandoms">' + fandoms.map(function(f) {
                    return '<span class="badge bg-secondary">' + f + '</span>';
                }).join('') + '</div>'
                : '';

            // Working hours
            var whHtml = '';
            try {
                var h = JSON.parse(wh);
                var days = ['monday','tuesday','wednesday','thursday','friday','saturday','sunday'];
                var names = ['Пн','Вт','Ср','Чт','Пт','Сб','Вс'];
                whHtml = '<table class="loc-wh-table"><tbody>';
                for (var i = 0; i < 7; i++) {
                    var v = h[days[i]] || '—';
                    if (v === 'closed') v = 'Закрыто';
                    whHtml += '<tr><td>' + names[i] + '</td><td>' + v + '</td></tr>';
                }
                whHtml += '</tbody></table>';
            } catch(e) { whHtml = '<p class="text-muted" style="font-size:0.85rem;">Не указано</p>'; }

            // Hero image
            var imgHtml = img
                ? '<div class="loc-hero-img" style="background-image:url(\'' + img + '\');"></div>'
                : '<div class="loc-hero-img loc-hero-placeholder"><span>' + typeEmoji(type) + '</span><div>' + typeName(type) + '</div></div>';

            // Planner button
            var plannerBtnHtml = isAuthenticated
                ? '<button class="loc-add-btn" onclick="addToPlannerFromSheet(' + id + ',\'' + name.replace(/'/g, "\\'") + '\')" title="Добавить в планер"><i class="fas fa-plus"></i></button>'
                : '<button class="loc-add-btn" onclick="closeLocSheet(); requireAuth(\'Добавить в планер\')" title="Добавить в планер"><i class="fas fa-plus"></i></button>';

            // Build content
            var html =
                '<div class="loc-sheet-header">' +
                    '<span class="loc-name">' + name + '</span>' +
                    '<div class="loc-header-btns">' +
                        plannerBtnHtml +
                        '<button type="button" class="loc-share-btn" onclick="shareLocation(' + id + ')" title="Поделиться"><i class="fas fa-share-alt"></i></button>' +
                        '<button type="button" class="loc-close-btn" onclick="closeLocSheet()"><i class="fas fa-times"></i></button>' +
                    '</div>' +
                '</div>' +
                '<div class="loc-sheet-body">' +
                    imgHtml +
                    '<div class="loc-type-badge">' + typeEmoji(type) + ' ' + typeName(type) + (catName ? ' · ' + catName : '') + '</div>' +
                    '<div class="loc-rating">' + starsHtml + ' <strong>' + Number(rating).toFixed(1) + '</strong> <span class="text-muted">(' + reviewCount + ' отзывов)</span></div>' +
                    fandomsHtml +
                    (desc ? '<p class="loc-desc">' + desc + '</p>' : '') +
                    '<div class="loc-info-row"><i class="fas fa-map-marker-alt"></i><span>' + addr + '</span></div>' +
                    '<div style="font-weight:600;font-size:0.9rem;margin:12px 0 6px;"><i class="fas fa-clock"></i> Часы работы</div>' +
                    whHtml +
                '</div>';

            document.getElementById('locSheetContent').innerHTML = html;

            // Load reviews
            loadLocReviews(id);

            document.getElementById('locSheetOverlay').classList.add('open');
            document.body.style.overflow = 'hidden';
        }

        function loadLocReviews(id) {
            fetch('/Review/GetByLocation?locationId=' + id)
                .then(function(r) { return r.json(); })
                .then(function(reviews) {
                    var body = document.querySelector('#locSheet .loc-sheet-body');
                    if (!body) return;

                    // Remove old reviews section and form if reloading
                    var oldSection = body.querySelector('.loc-reviews-section');
                    if (oldSection) oldSection.remove();
                    var oldForm = body.querySelector('.loc-review-form');
                    if (oldForm) oldForm.remove();

                    var section = document.createElement('div');
                    section.className = 'loc-reviews-section';

                    var title = '<div class="loc-reviews-title"><i class="fas fa-comments"></i> Отзывы</div>';
                    var reviewsHtml = '';

                    if (!reviews || reviews.length === 0) {
                        reviewsHtml = '<div class="loc-review-empty">Пока нет отзывов. Будьте первым!</div>';
                    } else {
                        reviews.forEach(function(r) {
                            var rStars = '';
                            for (var i = 1; i <= 5; i++) {
                                rStars += '<i class="fa-star ' + (i <= r.rating ? 'fas' : 'far') + '"></i>';
                            }
                            var dateStr = r.createdAt ? new Date(r.createdAt).toLocaleDateString('ru-RU') : '';
                            var photosHtml = '';
                            if (r.photoPaths) {
                                var photos = r.photoPaths.split(';').filter(function(p) { return p && p.trim(); });
                                if (photos.length > 0) {
                                    photosHtml = '<div class="rev-photos">';
                                    photos.forEach(function(p) {
                                        photosHtml += '<img src="' + p.trim() + '" class="rev-photo" alt="" onerror="this.style.display=\'none\'" />';
                                    });
                                    photosHtml += '</div>';
                                }
                            }
                            reviewsHtml +=
                                '<div class="loc-review-item">' +
                                    '<div class="rev-header">' +
                                        '<span class="rev-author">' + (r.userName || 'Аноним') + '</span>' +
                                        '<span class="rev-date">' + dateStr + '</span>' +
                                    '</div>' +
                                    '<div class="rev-stars">' + rStars + '</div>' +
                                    '<div class="rev-text">' + (r.text || '') + '</div>' +
                                    photosHtml +
                                '</div>';
                        });
                    }

                    section.innerHTML = title + reviewsHtml;
                    body.appendChild(section);

                    // Append review form
                    if (isAuthenticated) {
                        var formHtml =
                            '<div class="loc-review-form" id="locReviewForm">' +
                                '<div class="loc-star-input" id="locStarInput">' +
                                    [1,2,3,4,5].map(function(i) {
                                        return '<button type="button" data-val="' + i + '" onclick="setLocRating(' + i + ')" onmouseover="hoverLocRating(' + i + ')" onmouseout="resetLocRating()"><i class="far fa-star" id="loc-star-' + i + '"></i></button>';
                                    }).join('') +
                                '</div>' +
                                '<textarea id="locReviewText" rows="2" placeholder="Напишите ваш отзыв..."></textarea>' +
                                '<div class="loc-review-photo">' +
                                    '<label class="loc-review-photo-label" for="locReviewPhoto">' +
                                        '<i class="fas fa-camera"></i> Добавить фото' +
                                    '</label>' +
                                    '<input type="file" id="locReviewPhoto" accept="image/*" multiple style="display:none" onchange="handleLocPhotoSelect(this)"/>' +
                                    '<div id="locPhotoPreview" class="loc-review-photo-preview"></div>' +
                                '</div>' +
                                '<div class="loc-review-submit">' +
                                    '<button class="btn-submit" onclick="submitLocReview(' + id + ')"><i class="fas fa-paper-plane"></i> Отправить</button>' +
                                    '<button class="btn-cancel" onclick="closeLocSheet()">Отмена</button>' +
                                '</div>' +
                            '</div>';
                        body.insertAdjacentHTML('beforeend', formHtml);
                    } else {
                        var loginHtml = '<div class="loc-review-form" style="text-align:center;font-size:0.85rem;color:var(--color-secondary);"><a href="/Account/Login" style="color:var(--color-black);font-weight:600;">Войдите</a>, чтобы оставить отзыв</div>';
                        body.insertAdjacentHTML('beforeend', loginHtml);
                    }
                })
                .catch(function() {
                    var body = document.querySelector('#locSheet .loc-sheet-body');
                    if (!body) return;
                    var section = document.createElement('div');
                    section.className = 'loc-reviews-section';
                    section.innerHTML = '<div class="loc-reviews-title"><i class="fas fa-comments"></i> Отзывы</div><div class="loc-review-empty">Ошибка загрузки отзывов</div>';
                    body.appendChild(section);
                });
        }

        // Review form state
        var locReviewRating = 0;

        function setLocRating(val) {
            locReviewRating = val;
            for (var i = 1; i <= 5; i++) {
                var el = document.getElementById('loc-star-' + i);
                if (el) el.className = i <= val ? 'fas fa-star' : 'far fa-star';
            }
        }
        function hoverLocRating(val) {
            for (var i = 1; i <= 5; i++) {
                var el = document.getElementById('loc-star-' + i);
                if (el) el.className = i <= val ? 'fas fa-star' : 'far fa-star';
            }
        }
        function resetLocRating() {
            setLocRating(locReviewRating);
        }

        var locReviewPhotos = [];

        function handleLocPhotoSelect(input) {
            var preview = document.getElementById('locPhotoPreview');
            preview.innerHTML = '';
            locReviewPhotos = [];
            var files = input.files;
            for (var i = 0; i < Math.min(files.length, 5); i++) {
                (function(file, idx) {
                    var reader = new FileReader();
                    reader.onload = function(e) {
                        locReviewPhotos[idx] = e.target.result;
                        var div = document.createElement('div');
                        div.className = 'loc-photo-thumb';
                        div.innerHTML = '<img src="' + e.target.result + '" /><button type="button" class="loc-photo-remove" onclick="removeLocPhoto(' + idx + ')"><i class="fas fa-times"></i></button>';
                        preview.appendChild(div);
                    };
                    reader.readAsDataURL(file);
                })(files[i], i);
            }
        }

        function removeLocPhoto(idx) {
            locReviewPhotos[idx] = null;
            var preview = document.getElementById('locPhotoPreview');
            var thumbs = preview.querySelectorAll('.loc-photo-thumb');
            if (thumbs[idx]) thumbs[idx].remove();
        }

        function submitLocReview(locId) {
            var text = document.getElementById('locReviewText').value.trim();
            if (locReviewRating === 0) { alert('Выберите оценку'); return; }
            if (!text) { alert('Напишите текст отзыва'); return; }
            var validPhotos = locReviewPhotos.filter(function(p) { return p; });
            if (validPhotos.length === 0) { alert('Добавьте хотя бы одно фото'); return; }

            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            var formData = new FormData();
            formData.append('locationId', locId);
            formData.append('rating', locReviewRating);
            formData.append('text', text);
            if (token) formData.append('__RequestVerificationToken', token.value);

            // Append photos
            locReviewPhotos.forEach(function(photo, i) {
                if (photo) formData.append('PhotoBase64_' + i, photo);
            });

            fetch('/Review/CreateAjax', {
                method: 'POST',
                body: formData
            }).then(function(r) {
                if (r.redirected) { window.location.href = r.url; return; }
                return r.json();
            }).then(function(data) {
                if (data && data.success) {
                    document.getElementById('locReviewText').value = '';
                    setLocRating(0);
                    locReviewRating = 0;
                    locReviewPhotos = [];
                    var preview = document.getElementById('locPhotoPreview');
                    if (preview) preview.innerHTML = '';
                    loadLocReviews(locId);
                } else {
                    alert('Ошибка при отправке отзыва.');
                }
            }).catch(function() {
                alert('Не удалось отправить отзыв.');
            });
        }

        function shareLocation(locId) {
            var loc = findLoc(locId);
            if (!loc) return;
            var name = loc.name || loc.Name;
            var lat = loc.latitude || loc.Latitude;
            var lng = loc.longitude || loc.Longitude;
            var addr = loc.address || loc.Address || '';
            var shareText = name + '\n' + addr + '\nКоординаты: ' + lat.toFixed(6) + ', ' + lng.toFixed(6) + '\nhttps://www.google.com/maps?q=' + lat + ',' + lng;
            if (navigator.clipboard) {
                navigator.clipboard.writeText(shareText).then(function() {
                    alert('Скопировано! ✅');
                }).catch(function() {
                    prompt('Скопируйте текст:', shareText);
                });
            } else {
                prompt('Скопируйте текст:', shareText);
            }
        }

        function closeLocSheet() {
            document.getElementById('locSheetOverlay').classList.remove('open');
            document.body.style.overflow = '';
            currentLocId = null;
            currentLocData = null;
            locReviewRating = 0;
        }

        // Close on Escape
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeLocSheet();
        });

        // ═══ Popup action buttons ═══
        function findLoc(id) {
            var found = null;
            allLocations.forEach(function(l) { if ((l.id || l.Id) === id) found = l; });
            return found;
        }

        function addToRoute(id) {
            if (!requireAuth('Добавить в маршрут')) return;
            var loc = findLoc(id);
            if (!loc) return;
            var name = loc.name || loc.Name;
            var route = JSON.parse(localStorage.getItem('gt_route') || '[]');
            if (route.find(function(l) { return (l.id || l.Id) === id; })) {
                alert('"' + name + '" уже в маршруте');
                return;
            }
            route.push({ id: id, name: name, lat: loc.latitude || loc.Latitude, lng: loc.longitude || loc.Longitude });
            localStorage.setItem('gt_route', JSON.stringify(route));
            alert('"' + name + '" добавлено в маршрут! 📍');
        }

        function addToCalendar(id) {
            if (!requireAuth('Добавить в календарь')) return;
            var loc = findLoc(id);
            if (!loc) return;
            var name = loc.name || loc.Name;
            var date = prompt('Введите дату (ГГГГ-ММ-ДД):', new Date().toISOString().split('T')[0]);
            if (!date) return;
            var time = prompt('Введите время:', '12:00');
            var plan = JSON.parse(localStorage.getItem('gt_plan') || '[]');
            plan.push({ date: date, time: time || '12:00', locId: id, locName: name });
            localStorage.setItem('gt_plan', JSON.stringify(plan));
            alert('Добавлено: ' + name + ' на ' + date + ' ' + (time || '12:00') + ' 📅');
        }

        function writeReview(id) {
            if (!requireAuth('Написать отзыв')) return;
            var loc = findLoc(id);
            if (!loc) return;
            var name = loc.name || loc.Name;
            switchTab('reviews');
            showReviewForm(id, name);
        }

        function showReviewForm(locId, locName) {
            var container = document.getElementById('reviewFormContainer');
            container.innerHTML =
                '<div class="card">' +
                    '<div class="card-header">' +
                        '<h5 class="mb-0"><i class="fas fa-pen"></i> Отзыв о «' + locName + '»</h5>' +
                    '</div>' +
                    '<div class="card-body">' +
                        '<form id="reviewForm" onsubmit="submitReview(event, ' + locId + ')">' +
                            '<div class="mb-3">' +
                                '<label class="form-label">Оценка</label>' +
                                '<div class="star-rating d-flex gap-1" id="starRating">' +
                                    [1,2,3,4,5].map(function(i) {
                                        return '<button type="button" class="btn star-btn" data-value="' + i + '" onclick="setRating(' + i + ')" onmouseover="hoverRating(' + i + ')" onmouseout="resetHover()">' +
                                            '<i class="far fa-star" id="star-' + i + '"></i></button>';
                                    }).join('') +
                                '</div>' +
                                '<input type="hidden" id="ratingInput" value="0" />' +
                            '</div>' +
                            '<div class="mb-3">' +
                                '<label class="form-label">Текст отзыва</label>' +
                                '<textarea class="form-control" id="reviewText" rows="4" placeholder="Поделитесь впечатлениями о «' + locName + '»..."></textarea>' +
                            '</div>' +
                            '<div class="d-flex gap-2">' +
                                '<button type="submit" class="btn btn-dark" id="submitReviewBtn" disabled><i class="fas fa-paper-plane"></i> Отправить</button>' +
                                '<button type="button" class="btn btn-outline-dark" onclick="cancelReview()">Отмена</button>' +
                            '</div>' +
                        '</form>' +
                    '</div>' +
                '</div>';
        }

        function cancelReview() {
            var container = document.getElementById('reviewFormContainer');
            container.innerHTML =
                '<div class="card"><div class="card-body text-center py-5">' +
                    '<i class="fas fa-map-marker-alt fa-3x text-muted mb-3"></i>' +
                    '<h5>Выберите заведение</h5>' +
                    '<p class="text-muted">Кликните на маркер на карте, затем нажмите<br>«Написать отзыв» чтобы перейти сюда.</p>' +
                '</div></div>';
        }

        function submitReview(e, locId) {
            e.preventDefault();
            var rating = parseInt(document.getElementById('ratingInput').value);
            var text = document.getElementById('reviewText').value.trim();
            if (rating === 0) { alert('Выберите оценку'); return; }
            if (!text) { alert('Напишите текст отзыва'); return; }

            fetch('/Review/Create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'LocationId=' + locId + '&Rating=' + rating + '&Text=' + encodeURIComponent(text)
            }).then(function(r) {
                if (r.redirected) { window.location.href = r.url; return; }
                return r.json();
            }).then(function(data) {
                if (data && data.success) {
                    alert('Отзыв отправлен на модерацию! ✅');
                    cancelReview();
                }
            }).catch(function() {
                alert('Не удалось отправить отзыв. Возможно, нужно войти в аккаунт.');
            });
        }

        // Star rating
        var currentRating = 0;
        function setRating(value) {
            currentRating = value;
            document.getElementById('ratingInput').value = value;
            updateStars(value);
            document.getElementById('submitReviewBtn').disabled = false;
        }
        function hoverRating(value) { updateStars(value); }
        function resetHover() { updateStars(currentRating); }
        function updateStars(value) {
            for (var i = 1; i <= 5; i++) {
                var star = document.getElementById('star-' + i);
                if (i <= value) { star.classList.remove('far'); star.classList.add('fas'); star.style.color = '#FFC107'; }
                else { star.classList.remove('fas'); star.classList.add('far'); star.style.color = '#CCC'; }
            }
        }

        // ═══ Tab switching ═══
        function switchTab(tabName) {
            document.querySelectorAll('.home-tab').forEach(function(t) { t.classList.remove('active'); });
            document.querySelectorAll('.home-tab-content').forEach(function(c) { c.classList.remove('active'); });
            var tabBtn = document.querySelector('[data-tab="' + tabName + '"]');
            if (tabBtn) tabBtn.classList.add('active');
            var tabContent = document.getElementById('tab-' + tabName);
            if (tabContent) tabContent.classList.add('active');

            // Show sidebar & toggle button only on Map tab
            var sidebar = document.getElementById('homeSidebar');
            var toggleBtn = document.getElementById('sidebarToggleBtn');
            if (sidebar) {
                if (tabName === 'map') {
                    sidebar.classList.remove('hidden-sidebar');
                } else {
                    sidebar.classList.add('hidden-sidebar');
                }
            }
            if (toggleBtn) {
                if (tabName === 'map') {
                    toggleBtn.style.display = '';
                } else {
                    toggleBtn.style.display = 'none';
                }
            }

            if (tabName === 'map') setTimeout(function() { map.invalidateSize(); }, 100);
            if (tabName === 'planner') { renderCalendar(); renderPlannerList(); switchPlannerTab('calendar'); }
        }

        // ═══ Filters ═══
        function getSelectedFandoms() {
            var ids = [];
            document.querySelectorAll('.fandom-checkbox:checked').forEach(function(cb) { ids.push(parseInt(cb.value)); });
            return ids;
        }

        function hasActiveFilters() {
            return document.getElementById('searchInput').value !== ''
                || document.getElementById('typeFilter').value !== ''
                || getSelectedFandoms().length > 0
                || document.getElementById('categoryFilter').value !== ''
                || document.getElementById('ratingFilter').value !== ''
                || document.getElementById('sortFilter').value !== 'rating';
        }

        function updateResetButtons() {
            var sideBtn = document.getElementById('sidebarResetBtn');
            if (hasActiveFilters()) {
                if (sideBtn) sideBtn.style.display = 'block';
            } else {
                if (sideBtn) sideBtn.style.display = 'none';
            }
        }

        var sidebarCollapsed = false;
        function toggleSidebar() {
            var sidebar = document.getElementById('homeSidebar');
            var toggleBtn = document.getElementById('sidebarToggleBtn');
            var icon = document.getElementById('sidebarToggleIcon');
            sidebarCollapsed = !sidebarCollapsed;
            if (sidebarCollapsed) {
                sidebar.classList.add('sidebar-collapsed');
                toggleBtn.classList.add('collapsed');
                if (icon) icon.classList.replace('fa-chevron-left', 'fa-chevron-right');
            } else {
                sidebar.classList.remove('sidebar-collapsed');
                toggleBtn.classList.remove('collapsed');
                if (icon) icon.classList.replace('fa-chevron-right', 'fa-chevron-left');
            }
        }

        function applyFilters() {
            var params = new URLSearchParams();
            var search = document.getElementById('searchInput').value.trim();
            var type = document.getElementById('typeFilter').value;
            var fandomIds = getSelectedFandoms();
            var category = document.getElementById('categoryFilter').value;
            var rating = document.getElementById('ratingFilter').value;
            var sort = document.getElementById('sortFilter').value;

            if (search) params.set('searchQuery', search);
            if (type) params.set('type', type);
            fandomIds.forEach(function(id) { params.append('fandomId', id); });
            if (category) params.set('categoryId', category);
            if (rating) params.set('minRating', rating);
            if (sort && sort !== 'rating') params.set('sortBy', sort);

            document.getElementById('loadingOverlay').style.display = 'flex';
            fetch('/Home/GetFilteredLocations?' + params.toString())
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    allLocations = data;
                    var count = addMarkers(data);
                    document.getElementById('locCount').textContent = count;
                    updateResetButtons();
                    document.getElementById('loadingOverlay').style.display = 'none';
                })
                .catch(function(err) {
                    console.error('Filter error:', err);
                    document.getElementById('loadingOverlay').style.display = 'none';
                });
        }

        function resetAllFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('typeFilter').value = '';
            document.querySelectorAll('.fandom-checkbox').forEach(function(cb) { cb.checked = false; });
            document.getElementById('categoryFilter').value = '';
            document.getElementById('ratingFilter').value = '';
            document.getElementById('sortFilter').value = 'rating';
            var sideBtn = document.getElementById('sidebarResetBtn');
            if (sideBtn) sideBtn.style.display = 'none';
            document.getElementById('loadingOverlay').style.display = 'flex';
            fetch('/Home/GetFilteredLocations')
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    allLocations = data;
                    var count = addMarkers(data);
                    document.getElementById('locCount').textContent = count;
                    document.getElementById('loadingOverlay').style.display = 'none';
                })
                .catch(function(err) {
                    console.error('Reset error:', err);
                    document.getElementById('loadingOverlay').style.display = 'none';
                });
        }

        // ═══ PLANNER: Calendar + Points management ═══
        var plannerData = JSON.parse(localStorage.getItem('gt_plan') || '[]');
        var calendarCurrentDate = new Date();
        var calendarSelectedDate = null;

        function savePlanner() {
            localStorage.setItem('gt_plan', JSON.stringify(plannerData));
            renderPlannerList();
            renderCalendar();
            updatePlannerCount();
        }

        function updatePlannerCount() {
            var count = plannerData.length;
            document.getElementById('plannerCount').textContent = count;
            document.getElementById('buildRouteBtn').disabled = count < 2;
        }

        function addToPlannerFromMap(id, name) {
            if (!requireAuth('Добавить в планер')) return;
            var date = prompt('Введите дату (ГГГГ-ММ-ДД):', new Date().toISOString().split('T')[0]);
            if (!date) return;
            var time = prompt('Введите время:', '12:00');
            if (!time) return;
            if (addToPlanner(id, name, date, time)) {
                alert('✅ "' + name + '" добавлено в планер на ' + formatDateRu(date) + ' ' + time);
            }
        }

        function addToPlannerFromSheet(id, name) {
            if (!requireAuth('Добавить в планер')) return;
            closeLocSheet();
            var date = prompt('Введите дату (ГГГГ-ММ-ДД):', new Date().toISOString().split('T')[0]);
            if (!date) return;
            var time = prompt('Введите время:', '12:00');
            if (!time) return;
            if (addToPlanner(id, name, date, time)) {
                alert('✅ "' + name + '" добавлено в планер на ' + formatDateRu(date) + ' ' + time);
            }
        }

        function addToPlanner(id, name, date, time) {
            var timeStr = time || '12:00';
            if (plannerData.find(function(p) { return p.locId === id && p.date === date && p.time === timeStr; })) {
                alert('"' + name + '" уже запланировано на ' + formatDateRu(date) + ' в ' + timeStr);
                return false;
            }
            plannerData.push({ date: date, time: timeStr, locId: id, locName: name });
            savePlanner();
            // Switch to planner tab
            switchTab('planner');
            return true;
        }

        function removeFromPlanner(index) {
            plannerData.splice(index, 1);
            savePlanner();
        }

        function clearPlanner() {
            if (!confirm('Очистить весь план?')) return;
            plannerData = [];
            savePlanner();
            document.getElementById('dayPointsList').innerHTML = '';
            document.getElementById('selectedDateDisplay').textContent = 'не выбрана';
            calendarSelectedDate = null;
        }

        function formatDateRu(dateStr) {
            if (!dateStr) return '';
            var parts = dateStr.split('-');
            if (parts.length !== 3) return dateStr;
            return parts[2] + '.' + parts[1] + '.' + parts[0];
        }

        function formatDateShort(dateStr) {
            if (!dateStr) return '';
            var parts = dateStr.split('-');
            if (parts.length !== 3) return dateStr;
            var months = ['янв','фев','мар','апр','май','июн','июл','авг','сен','окт','ноя','дек'];
            return parts[2] + ' ' + months[parseInt(parts[1]) - 1];
        }

        // ═══ Calendar rendering ═══
        function renderCalendar() {
            var year = calendarCurrentDate.getFullYear();
            var month = calendarCurrentDate.getMonth();

            // Month/year header
            var months = ['Январь','Февраль','Март','Апрель','Май','Июнь','Июль','Август','Сентябрь','Октябрь','Ноябрь','Декабрь'];
            document.getElementById('calendarMonthYear').textContent = months[month] + ' ' + year;

            // Build grid
            var grid = document.getElementById('calendarDays');
            grid.innerHTML = '';

            var firstDay = new Date(year, month, 1);
            var lastDay = new Date(year, month + 1, 0);
            var startDow = firstDay.getDay(); // 0=Sun
            // Convert to Mon=0 format
            var startOffset = startDow === 0 ? 6 : startDow - 1;

            // Previous month filler
            var prevMonthLastDay = new Date(year, month, 0).getDate();
            for (var i = startOffset - 1; i >= 0; i--) {
                var dayDiv = document.createElement('div');
                dayDiv.className = 'calendar-day other-month';
                dayDiv.textContent = prevMonthLastDay - i;
                grid.appendChild(dayDiv);
            }

            // Current month days
            var today = new Date();
            today.setHours(0, 0, 0, 0);
            var todayStr = today.toISOString().split('T')[0];

            for (var d = 1; d <= lastDay.getDate(); d++) {
                var dateStr = year + '-' + String(month + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0');
                var dayDiv = document.createElement('div');
                dayDiv.className = 'calendar-day';
                dayDiv.textContent = d;

                // Today highlight
                if (dateStr === todayStr) {
                    dayDiv.classList.add('today');
                }

                // Selected date
                if (calendarSelectedDate === dateStr) {
                    dayDiv.classList.add('selected');
                }

                // Has planned points?
                var dayPoints = plannerData.filter(function(p) { return p.date === dateStr; });
                if (dayPoints.length > 0) {
                    dayDiv.classList.add('has-points');
                    var dot = document.createElement('span');
                    dot.className = 'calendar-dot';
                    if (dayPoints.length > 1) dot.textContent = dayPoints.length;
                    dayDiv.appendChild(dot);
                }

                (function(ds) {
                    dayDiv.addEventListener('click', function() {
                        calendarSelectedDate = ds;
                        renderCalendar();
                        showDayPoints(ds);
                    });
                })(dateStr);

                grid.appendChild(dayDiv);
            }

            // Next month filler
            var totalCells = startOffset + lastDay.getDate();
            var remaining = (7 - totalCells % 7) % 7;
            if (remaining > 0 || totalCells < 35) {
                var fill = remaining > 0 ? remaining : 7;
                for (var n = 1; n <= fill; n++) {
                    var dayDiv = document.createElement('div');
                    dayDiv.className = 'calendar-day other-month';
                    dayDiv.textContent = n;
                    grid.appendChild(dayDiv);
                }
            }
        }

        function calendarPrev() {
            calendarCurrentDate.setDate(1);
            calendarCurrentDate.setMonth(calendarCurrentDate.getMonth() - 1);
            renderCalendar();
        }

        function calendarNext() {
            calendarCurrentDate.setDate(1);
            calendarCurrentDate.setMonth(calendarCurrentDate.getMonth() + 1);
            renderCalendar();
        }

        function showDayPoints(dateStr) {
            document.getElementById('selectedDateDisplay').textContent = formatDateRu(dateStr);
            var container = document.getElementById('dayPointsList');
            var points = plannerData.filter(function(p) { return p.date === dateStr; });

            if (points.length === 0) {
                container.innerHTML = '<small class="text-muted">Нет запланированных точек</small>';
                return;
            }

            var html = '';
            points.forEach(function(p) {
                var globalIdx = plannerData.indexOf(p);
                html += '<div class="day-point-item">' +
                    '<span class="day-point-time">' + (p.time || '—') + '</span>' +
                    '<span class="day-point-name">' + p.locName + '</span>' +
                    '<button type="button" class="btn btn-sm btn-outline-danger" onclick="removeFromPlanner(' + globalIdx + ')">' +
                        '<i class="fas fa-times"></i>' +
                    '</button>' +
                '</div>';
            });
            container.innerHTML = html;
        }

        // ═══ Planner list rendering ═══
        function renderPlannerList() {
            var container = document.getElementById('plannerList');

            if (plannerData.length === 0) {
                container.innerHTML =
                    '<div class="text-center py-5 text-muted" id="plannerEmpty">' +
                        '<i class="fas fa-calendar-plus fa-2x mb-2"></i>' +
                        '<p class="mb-0">Нажмите <i class="fas fa-calendar"></i> на карте, чтобы добавить точку в календарь</p>' +
                    '</div>';
                return;
            }

            // Sort by date then time
            var sorted = plannerData.map(function(p, i) { return { item: p, idx: i }; })
                .sort(function(a, b) {
                    if (a.item.date !== b.item.date) return a.item.date.localeCompare(b.item.date);
                    return (a.item.time || '').localeCompare(b.item.time || '');
                });

            var html = '';
            var lastDate = '';
            sorted.forEach(function(entry) {
                var p = entry.item;
                var idx = entry.idx;

                // Date header
                if (p.date !== lastDate) {
                    if (lastDate !== '') html += '</div>'; // close previous group
                    lastDate = p.date;
                    html += '<div class="planner-date-group">' +
                        '<div class="planner-date-header">' + formatDateRu(p.date) + '</div>';
                }

                html += '<div class="planner-item">' +
                    '<div class="planner-item-time"><i class="fas fa-clock"></i> ' + (p.time || '—') + '</div>' +
                    '<div class="planner-item-name">' + p.locName + '</div>' +
                    '<div class="planner-item-actions">' +
                        '<button type="button" class="btn btn-sm btn-outline-dark" onclick="focusPlannerPoint(' + p.locId + ')" title="Показать на карте"><i class="fas fa-map-marker-alt"></i></button>' +
                        '<button type="button" class="btn btn-sm btn-outline-danger" onclick="removeFromPlanner(' + idx + ')" title="Удалить"><i class="fas fa-trash"></i></button>' +
                    '</div>' +
                '</div>';
            });
            if (lastDate !== '') html += '</div>';

            container.innerHTML = html;
        }

        function focusPlannerPoint(locId) {
            var loc = findLoc(locId);
            if (loc) {
                switchTab('map');
                focusLocation(locId, loc.latitude || loc.Latitude, loc.longitude || loc.Longitude);
            }
        }

        // ═══ Build route from planner points ═══
        function buildRouteFromPlanner() {
            if (plannerData.length < 2) {
                alert('Добавьте хотя бы 2 точки в план');
                return;
            }

            // Sort by date/time
            var sorted = plannerData.slice().sort(function(a, b) {
                if (a.date !== b.date) return a.date.localeCompare(b.date);
                return (a.time || '').localeCompare(b.time || '');
            });

            // Store route points for the Routes page
            var routePoints = sorted.map(function(p) {
                var loc = findLoc(p.locId);
                return {
                    locId: p.locId,
                    locName: p.locName,
                    date: p.date,
                    time: p.time,
                    lat: loc ? (loc.latitude || loc.Latitude) : 0,
                    lng: loc ? (loc.longitude || loc.Longitude) : 0
                };
            });
            localStorage.setItem('gt_route_build', JSON.stringify(routePoints));

            // Navigate to Routes page
            window.location.href = '/Route/Create?fromPlanner=true';
        }

        // Override addToCalendar to also add to planner
        var origAddToCalendar = addToCalendar;
        function addToCalendar(id) {
            if (!requireAuth('Добавить в календарь')) return;
            var loc = findLoc(id);
            if (!loc) return;
            var name = loc.name || loc.Name;
            var date = prompt('Введите дату (ГГГГ-ММ-ДД):', new Date().toISOString().split('T')[0]);
            if (!date) return;
            var time = prompt('Введите время:', '12:00');
            if (addToPlanner(id, name, date, time)) {
                alert('Добавлено: ' + name + ' на ' + formatDateRu(date) + ' ' + (time || '12:00') + ' 📅');
            }
        }

        // Init planner on load
        renderCalendar();
        renderPlannerList();
        updatePlannerCount();

        // Planner sub-tabs
        function switchPlannerTab(tab) {
            document.querySelectorAll('#plannerTabs .nav-link').forEach(function(b) { b.classList.remove('active'); });
            document.querySelector('[data-planner-tab="' + tab + '"]').classList.add('active');
            document.querySelectorAll('.planner-sub-tab').forEach(function(c) { c.classList.remove('active'); });
            document.getElementById('planner-tab-' + tab).classList.add('active');
            if (tab === 'myroutes') loadMyRoutes();
            if (tab === 'public') loadPublicRoutes();
        }

        function loadMyRoutes() {
            console.log('loadMyRoutes called');
            fetch('/Route/GetMyRoutes')
                .then(function(r) { console.log('GetMyRoutes response:', r.status); return r.json(); })
                .then(function(data) {
                    console.log('GetMyRoutes data:', data);
                    var routes = data || [];
                    document.getElementById('myRoutesCount').textContent = routes.length;
                    var container = document.getElementById('myRoutesFeed');
                    if (!routes.length) {
                        container.innerHTML = '<div class="text-center py-5 text-muted"><i class="fas fa-route fa-2x mb-2"></i><p class="mb-0">У вас пока нет маршрутов</p><a href="/Route/Create" class="btn btn-sm btn-dark mt-2">Создать маршрут</a></div>';
                        return;
                    }
                    var html = '';
                    routes.forEach(function(rt) {
                        var date = new Date(rt.createdAt).toLocaleDateString('ru-RU', { day: 'numeric', month: 'short', year: 'numeric' });
                        html += '<div class="profile-route-item"><div class="profile-route-info"><h6 class="mb-1"><i class="fas fa-route"></i> ' + rt.name + '</h6>';
                        html += '<small class="text-muted">' + (rt.description || '') + '</small>';
                        html += '<div class="profile-route-meta"><span><i class="fas fa-map-pin"></i> ' + (rt.pointCount || 0) + ' точек</span>';
                        html += '<span><i class="fas fa-calendar"></i> ' + date + '</span></div></div>';
                        var favIcon = rt.isFavorite ? 'fas' : 'far';
                        var favColor = rt.isFavorite ? '#FFC107' : '';
                        html += '<div class="profile-route-actions">';
                        html += '<button type="button" class="btn btn-sm" style="border:none;padding:4px 8px;" onclick="toggleRouteFavorite(' + rt.id + ', this)" title="Избранное"><i class="' + favIcon + ' fa-star" style="color:' + favColor + '"></i></button>';
                        html += '<button type="button" class="btn btn-sm btn-outline-dark" onclick="openRouteModal(' + rt.id + ')"><i class="fas fa-eye"></i></button>';
                        html += '</div></div>';
                    });
                    container.innerHTML = html;
                })
                .catch(function() { document.getElementById('myRoutesFeed').innerHTML = '<div class="text-center py-4 text-muted"><p>Ошибка загрузки</p></div>'; });
        }

        function toggleRouteFavorite(routeId, btn) {
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            var body = 'routeId=' + routeId;
            if (token) body += '&__RequestVerificationToken=' + encodeURIComponent(token.value);
            fetch('/Route/ToggleFavorite', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body
            }).then(function(r) { return r.json(); })
            .then(function(data) {
                if (data && data.success) {
                    var icon = btn.querySelector('i');
                    if (data.isFavorite) {
                        icon.classList.remove('far');
                        icon.classList.add('fas');
                        icon.style.color = '#FFC107';
                    } else {
                        icon.classList.remove('fas');
                        icon.classList.add('far');
                        icon.style.color = '';
                    }
                }
            }).catch(function() { alert('Ошибка'); });
        }

        function loadPublicRoutes() {
            fetch('/Route/GetPublicRoutes')
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    var routes = data || [];
                    document.getElementById('publicRoutesCount').textContent = routes.length;
                    var container = document.getElementById('publicRoutesFeed');
                    if (!routes.length) {
                        container.innerHTML = '<div class="text-center py-5 text-muted"><i class="fas fa-globe fa-2x mb-2"></i><p class="mb-0">Публичных маршрутов пока нет</p></div>';
                        return;
                    }
                    var html = '';
                    routes.forEach(function(rt) {
                        var date = new Date(rt.createdAt).toLocaleDateString('ru-RU', { day: 'numeric', month: 'short', year: 'numeric' });
                        html += '<div class="profile-route-item"><div class="profile-route-info"><h6 class="mb-1"><i class="fas fa-route"></i> ' + rt.name + '</h6>';
                        html += '<small class="text-muted">' + (rt.description || '') + '</small>';
                        html += '<div class="profile-route-meta"><span><i class="fas fa-map-pin"></i> ' + (rt.pointCount || 0) + ' точек</span>';
                        html += '<span><i class="fas fa-calendar"></i> ' + date + '</span></div></div>';
                        html += '<div class="profile-route-actions"><button type="button" class="btn btn-sm btn-outline-dark" onclick="openRouteModal(' + rt.id + ')"><i class="fas fa-eye"></i></button></div></div>';
                    });
                    container.innerHTML = html;
                })
                .catch(function() { document.getElementById('publicRoutesFeed').innerHTML = '<div class="text-center py-4 text-muted"><p>Ошибка загрузки</p></div>'; });
        }

        // ═══ Route Modal ═══
        function openRouteModal(routeId) {
            var modal = document.getElementById('routeModal');
            var content = document.getElementById('routeModalContent');
            modal.classList.add('open');
            content.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-dark"></div></div>';
            fetch('/Route/GetRouteData?id=' + routeId)
                .then(function(r) { return r.json(); })
                .then(function(rt) {
                    if (!rt || rt.error) { content.innerHTML = '<div class="text-center py-4 text-muted"><p>Маршрут не найден</p></div>'; return; }
                    var date = new Date(rt.createdAt).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
                    var html = '<div class="modal-detail"><div class="modal-body">';
                    html += '<div class="d-flex justify-content-between align-items-start mb-3">';
                    html += '<div><h4 class="modal-title mb-1">' + rt.name + '</h4>';
                    html += '<small class="text-muted"><i class="fas fa-calendar"></i> ' + date + '</small></div>';
                    html += '<span class="badge bg-dark"><i class="fas fa-map-pin"></i> ' + (rt.points ? rt.points.length : 0) + ' точек</span></div>';
                    if (rt.description) html += '<p class="modal-desc">' + rt.description + '</p>';
                    if (rt.points && rt.points.length > 0) {
                        html += '<h6 class="mt-3 mb-2"><i class="fas fa-route"></i> Точки маршрута</h6>';
                        html += '<div class="route-points-list">';
                        rt.points.forEach(function(p, i) {
                            html += '<div class="route-point-item"><div class="route-point-num">' + (i + 1) + '</div>';
                            html += '<div class="route-point-info"><b>' + p.locationName + '</b>';
                            if (p.locationAddress) html += '<br><small class="text-muted">' + p.locationAddress + '</small>';
                            if (p.plannedVisitTime) html += '<br><small><i class="fas fa-clock"></i> ' + new Date(p.plannedVisitTime).toLocaleTimeString('ru-RU', {hour:'2-digit',minute:'2-digit'}) + '</small>';
                            html += '</div></div>';
                        });
                        html += '</div>';
                    }
                    html += '<div class="modal-actions">';
                    html += '<a href="/Route/Details/' + rt.id + '" class="btn btn-dark"><i class="fas fa-external-link-alt"></i> Открыть маршрут</a>';
                    if (isAuthenticated) html += '<button type="button" class="btn btn-outline-dark" onclick="closeRouteModal()"><i class="fas fa-times"></i> Закрыть</button>';
                    html += '</div></div></div>';
                    content.innerHTML = html;
                })
                .catch(function() { content.innerHTML = '<div class="text-center py-4 text-muted"><p>Ошибка загрузки</p></div>'; });
        }
        function closeRouteModal() { document.getElementById('routeModal').classList.remove('open'); }

        // ═══ Build & Optimize Route ═══
        function buildRouteFromPlanner() {
            if (plannerData.length < 2) { alert('Добавьте хотя бы 2 точки в планер'); return; }
            var sorted = plannerData.slice().sort(function(a, b) {
                if (a.date !== b.date) return a.date.localeCompare(b.date);
                return (a.time || '').localeCompare(b.time || '');
            });
            var locationIds = sorted.map(function(p) { return p.locId; });
            var routeName = prompt('Название маршрута:', 'Мой маршрут');
            if (!routeName) return;
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            var body = 'name=' + encodeURIComponent(routeName) + '&description=&isPublic=false';
            locationIds.forEach(function(id) { body += '&locationIds=' + id; });
            if (token) body += '&__RequestVerificationToken=' + encodeURIComponent(token.value);
            fetch('/Route/CreateAjax', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: body })
                .then(function(r) {
                    if (!r.ok) throw new Error('HTTP ' + r.status);
                    return r.json();
                })
                .then(function(data) {
                    if (data && data.id) {
                        alert('✅ Маршрут "' + data.name + '" создан!');
                        plannerData = [];
                        savePlanner();
                        loadMyRoutes();
                        switchPlannerTab('myroutes');
                    } else {
                        alert('Ошибка при создании маршрута');
                    }
                })
                .catch(function(e) { alert('Ошибка: ' + e.message); });
        }

        // Event listeners
        document.getElementById('searchInput').addEventListener('input', updateResetButtons);
        document.getElementById('typeFilter').addEventListener('change', updateResetButtons);
        document.getElementById('categoryFilter').addEventListener('change', updateResetButtons);
        document.getElementById('ratingFilter').addEventListener('change', updateResetButtons);
        document.getElementById('sortFilter').addEventListener('change', updateResetButtons);
        document.getElementById('searchInput').addEventListener('keypress', function(e) { if (e.key === 'Enter') applyFilters(); });

        // Handle tab parameter from URL
        (function() {
            var params = new URLSearchParams(window.location.search);
            var tab = params.get('tab');
            if (tab && ['map', 'planner', 'reviews'].indexOf(tab) !== -1) {
                switchTab(tab);
            }
        })();
    </script>
}

@functions {
    private string GetLocationTypeName(LocationType type) => type switch
    {
        LocationType.Cafe => "Кафе",
        LocationType.Shop => "Магазин",
        LocationType.ArtObject => "Арт-объект",
        _ => type.ToString()
    };

    private string GetFandomEmoji(FandomCategory cat) => cat switch
    {
        FandomCategory.Anime => "🎌",
        FandomCategory.Comics => "💥",
        FandomCategory.VideoGames => "🎮",
        FandomCategory.BoardGames => "🎲",
        _ => "⭐"
    };
}
