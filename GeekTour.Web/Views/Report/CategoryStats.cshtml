@model List<GeekTour.Web.Models.ViewModels.CategoryStatsViewModel>
@{
    ViewData["Title"] = ViewBag.ReportTitle ?? "Статистика по категориям";
    var filter = ViewBag.Filter as GeekTour.Web.Models.ViewModels.ReportFilterViewModel;
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
}

<div class="admin-page-header">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h1><i class="fas fa-tags"></i> @ViewData["Title"]</h1>
            @if (filter != null)
            {
                <p class="text-muted mb-0">Период: @filter.StartDate.ToString("dd.MM.yyyy") — @filter.EndDate.ToString("dd.MM.yyyy")</p>
            }
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Report" asp-action="Index" class="btn btn-outline-dark"><i class="fas fa-arrow-left me-1"></i>Назад</a>
            <form method="post" asp-action="ExportCategoryStats" class="d-inline">
                <input type="hidden" name="StartDate" value="@(filter?.StartDate.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.AddMonths(-1).ToString("yyyy-MM-dd"))" />
                <input type="hidden" name="EndDate" value="@(filter?.EndDate.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.ToString("yyyy-MM-dd"))" />
                <button type="submit" class="btn btn-dark"><i class="fas fa-file-excel me-1"></i>Экспорт в Excel</button>
            </form>
        </div>
    </div>
</div>

    @if (filter != null)
    {
        <p class="text-muted">
            Период: @filter.StartDate.ToString("dd.MM.yyyy") — @filter.EndDate.ToString("dd.MM.yyyy")
        </p>
    }

    <div class="card">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Название категории</th>
                                <th class="text-center">Просмотры</th>
                                <th class="text-center">Поиски</th>
                                <th class="text-center">Кол-во заведений</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var item = Model[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td><strong>@item.CategoryName</strong></td>
                                    <td class="text-center"><span class="badge bg-dark">@item.ViewCount</span></td>
                                    <td class="text-center"><span class="badge bg-secondary">@item.SearchCount</span></td>
                                    <td class="text-center"><span class="badge bg-secondary">@item.LocationCount</span></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr style="background:#F5F5F5;">
                                <th colspan="2" class="text-end">Итого:</th>
                                <th class="text-center">@Model.Sum(m => m.ViewCount)</th>
                                <th class="text-center">@Model.Sum(m => m.SearchCount)</th>
                                <th class="text-center">@Model.Sum(m => m.LocationCount)</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-3x text-muted mb-3 d-block"></i>
                    <h5>Нет данных</h5>
                    <p class="text-muted">За выбранный период данные отсутствуют.</p>
                </div>
            }
        </div>
    </div>
</div>
