@model List<GeekTour.Web.Models.ViewModels.PopularRoutePointViewModel>
@{
    ViewData["Title"] = ViewBag.ReportTitle ?? "Популярные точки в маршрутах";
    var filter = ViewBag.Filter as GeekTour.Web.Models.ViewModels.ReportFilterViewModel;
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
}

<div class="admin-page-header">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h1><i class="fas fa-map-marker-alt"></i> @ViewData["Title"]</h1>
            @if (filter != null)
            {
                <p class="text-muted mb-0">Период: @filter.StartDate.ToString("dd.MM.yyyy") — @filter.EndDate.ToString("dd.MM.yyyy")</p>
            }
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Report" asp-action="Index" class="btn btn-outline-dark"><i class="fas fa-arrow-left me-1"></i>Назад</a>
            <form method="post" asp-action="ExportPopularRoutePoints" class="d-inline">
                <input type="hidden" name="StartDate" value="@(filter?.StartDate.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.AddMonths(-1).ToString("yyyy-MM-dd"))" />
                <input type="hidden" name="EndDate" value="@(filter?.EndDate.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.ToString("yyyy-MM-dd"))" />
                <button type="submit" class="btn btn-dark"><i class="fas fa-file-excel me-1"></i>Экспорт в Excel</button>
            </form>
        </div>
    </div>
</div>

    <div class="card">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Название точки</th>
                                <th class="text-center">Раз в маршрутах</th>
                                <th class="text-center">Доля маршрутов (%)</th>
                                <th>График</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var item = Model[i];
                                var percentage = item.PercentageOfRoutes;
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>
                                        <a href="/Location/Details/@item.LocationId"><strong>@item.LocationName</strong></a>
                                    </td>
                                    <td class="text-center"><span class="badge bg-dark">@item.TimesInRoutes</span></td>
                                    <td class="text-center"><span class="badge bg-secondary">@percentage.ToString("F1")%</span></td>
                                    <td style="min-width: 200px;">
                                        <div class="progress" style="height: 25px; background: #E0E0E0;">
                                            <div class="progress-bar" role="progressbar"
                                                 style="width: @percentage%; background: #000;"
                                                 aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100">
                                                @percentage.ToString("F1")%
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-3x text-muted mb-3 d-block"></i>
                    <h5>Нет данных</h5>
                    <p class="text-muted">За выбранный период данные отсутствуют.</p>
                </div>
            }
        </div>
    </div>
</div>
