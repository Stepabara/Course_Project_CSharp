@model List<GeekTour.Web.Models.ViewModels.LocationLoadViewModel>
@{
    ViewData["Title"] = ViewBag.ReportTitle ?? "Загрузка заведений по часам";
    var filter = ViewBag.Filter as GeekTour.Web.Models.ViewModels.ReportFilterViewModel;
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
}

<div class="admin-page-header">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h1><i class="fas fa-clock"></i> @ViewData["Title"]</h1>
            @if (filter != null)
            {
                <p class="text-muted mb-0">Период: @filter.StartDate.ToString("dd.MM.yyyy") — @filter.EndDate.ToString("dd.MM.yyyy")</p>
            }
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Report" asp-action="Index" class="btn btn-outline-dark"><i class="fas fa-arrow-left me-1"></i>Назад</a>
            <form method="post" asp-action="ExportLocationLoad" class="d-inline">
                <input type="hidden" name="StartDate" value="@(filter?.StartDate.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.AddMonths(-1).ToString("yyyy-MM-dd"))" />
                <input type="hidden" name="EndDate" value="@(filter?.EndDate.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.ToString("yyyy-MM-dd"))" />
                <input type="hidden" name="locationId" value="@ViewBag.LocationId" />
                <button type="submit" class="btn btn-dark"><i class="fas fa-file-excel me-1"></i>Экспорт в Excel</button>
            </form>
        </div>
    </div>
</div>

    <div class="card">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Часовой интервал</th>
                                <th>Заведение</th>
                                <th class="text-center">Кол-во посещений</th>
                                <th>Загрузка</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var maxVisits = Model.Max(m => m.VisitCount);
                            }
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var item = Model[i];
                                var percent = maxVisits > 0 ? (item.VisitCount * 100.0 / maxVisits) : 0;
                                var barColor = percent switch
                                {
                                    >= 75 => "#DC3545",
                                    >= 50 => "#FFC107",
                                    >= 25 => "#198754",
                                    _ => "#6C757D"
                                };
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td><strong>@item.HourLabel</strong></td>
                                    <td>@item.LocationName</td>
                                    <td class="text-center"><span class="badge bg-dark">@item.VisitCount</span></td>
                                    <td style="min-width: 200px;">
                                        <div class="progress" style="height: 25px; background: #E0E0E0;">
                                            <div class="progress-bar" role="progressbar"
                                                 style="width: @percent%; background: @barColor;"
                                                 aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
                                                @item.VisitCount
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-3x text-muted mb-3 d-block"></i>
                    <h5>Нет данных</h5>
                    <p class="text-muted">За выбранный период данные отсутствуют.</p>
                </div>
            }
        </div>
    </div>
</div>
