@model List<GeekTour.Web.Models.ViewModels.TopLocationViewModel>
@{
    ViewData["Title"] = ViewBag.ReportTitle ?? "Топ заведений";
    var filter = ViewBag.Filter as GeekTour.Web.Models.ViewModels.ReportFilterViewModel;
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
}

<div class="admin-page-header">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h1><i class="fas fa-trophy"></i> @ViewData["Title"]</h1>
            @if (filter != null)
            {
                <p class="text-muted mb-0">Период: @filter.StartDate.ToString("dd.MM.yyyy") — @filter.EndDate.ToString("dd.MM.yyyy")</p>
            }
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Report" asp-action="Index" class="btn btn-outline-dark"><i class="fas fa-arrow-left me-1"></i>Назад</a>
            <form method="post" asp-action="ExportTopLocations" class="d-inline">
                <input type="hidden" name="StartDate" value="@(filter?.StartDate.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.AddMonths(-1).ToString("yyyy-MM-dd"))" />
                <input type="hidden" name="EndDate" value="@(filter?.EndDate.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.ToString("yyyy-MM-dd"))" />
                <button type="submit" class="btn btn-dark"><i class="fas fa-file-excel me-1"></i>Экспорт в Excel</button>
            </form>
        </div>
    </div>
</div>

    <div class="card">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Название заведения</th>
                                <th class="text-center">Средний рейтинг</th>
                                <th class="text-center">Кол-во отзывов</th>
                                <th>Категория</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var item = Model[i];
                                <tr>
                                    <td>
                                        @if (i < 3)
                                        {
                                            <i class="fas fa-medal" style="color:@(i == 0 ? "#FFC107" : i == 1 ? "#6C757D" : "#DC3545");"></i>
                                            <span class="ms-1">@(i + 1)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">@(i + 1)</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="/Location/Details/@item.LocationId"><strong>@item.LocationName</strong></a>
                                    </td>
                                    <td class="text-center">
                                        <span class="rating-stars">
                                            @for (int s = 1; s <= 5; s++)
                                            {
                                                if (s <= Math.Round(item.AverageRating))
                                                {
                                                    <i class="fas fa-star"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star"></i>
                                                }
                                            }
                                        </span>
                                        <span class="ms-1 fw-bold">@item.AverageRating.ToString("F1")</span>
                                    </td>
                                    <td class="text-center"><span class="badge bg-secondary">@item.ReviewCount</span></td>
                                    <td><span class="badge bg-secondary">@item.CategoryName</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-inbox fa-3x text-muted mb-3 d-block"></i>
                    <h5>Нет данных</h5>
                    <p class="text-muted">За выбранный период данные отсутствуют.</p>
                </div>
            }
        </div>
    </div>
</div>
