@model List<GeekTour.Web.Models.Entities.Location>
@{
    ViewData["Title"] = "Акции";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4"><i class="fas fa-bullhorn"></i> Акции и события</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="text-center py-5 text-muted">
            <i class="fas fa-bullhorn fa-3x mb-3"></i>
            <h5>У вас пока нет заведений</h5>
            <p>Сначала добавьте заведение</p>
        </div>
    }
    else
    {
        foreach (var loc in Model)
        {
            <div class="card mb-4" style="border-radius: 12px;">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-store me-1"></i>@loc.Name</h5>
                    <button class="btn btn-sm btn-dark" data-bs-toggle="collapse" data-bs-target="#promo-@loc.Id">
                        <i class="fas fa-plus me-1"></i>Добавить акцию
                    </button>
                </div>
                <div class="card-body">
                    <div class="collapse mb-3" id="promo-@loc.Id">
                        <form method="post" asp-action="AddPromotion" class="p-3" style="background:#F5F5F5;border-radius:8px;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="locationId" value="@loc.Id" />
                            <div class="row g-2">
                                <div class="col-md-3">
                                    <input type="text" class="form-control" name="title" placeholder="Название" required maxlength="200" />
                                </div>
                                <div class="col-md-3">
                                    <input type="text" class="form-control" name="description" placeholder="Описание" />
                                </div>
                                <div class="col-md-2">
                                    <input type="date" class="form-control" name="startDate" required />
                                </div>
                                <div class="col-md-2">
                                    <input type="date" class="form-control" name="endDate" required />
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-dark w-100"><i class="fas fa-plus"></i></button>
                                </div>
                            </div>
                        </form>
                    </div>

                    @if (loc.Promotions.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead>
                                    <tr>
                                        <th>Название</th>
                                        <th>Описание</th>
                                        <th>Период</th>
                                        <th>Статус</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var promo in loc.Promotions.OrderByDescending(p => p.StartDate))
                                    {
                                        <tr>
                                            <td class="fw-bold">@promo.Title</td>
                                            <td class="text-muted">@(promo.Description?.Length > 60 ? promo.Description[..60] + "..." : promo.Description)</td>
                                            <td>@promo.StartDate.ToString("dd.MM") — @promo.EndDate.ToString("dd.MM")</td>
                                            <td>
                                                @if (promo.IsActive)
                                                {
                                                    <span class="badge bg-dark">Активна</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Неактивна</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">Акций пока нет</p>
                    }
                </div>
            </div>
        }
    }
</div>
