@{
    ViewData["Title"] = "Кабинет партнёра";
    var locations = ViewBag.Locations as List<GeekTour.Web.Models.Entities.Location> ?? new List<GeekTour.Web.Models.Entities.Location>();
    var reviews = ViewBag.Reviews as List<GeekTour.Web.Models.Entities.Review> ?? new List<GeekTour.Web.Models.Entities.Review>();
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4"><i class="fas fa-briefcase"></i> Кабинет партнёра</h2>

    <!-- Stats -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="stats-card">
                <div class="stats-value">@locations.Count</div>
                <div class="stats-label">Заведений</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stats-card">
                <div class="stats-value">@ViewBag.TotalViews</div>
                <div class="stats-label">Просмотров</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stats-card">
                <div class="stats-value">@ViewBag.AvgRating.ToString("F1")</div>
                <div class="stats-label">Средний рейтинг</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stats-card">
                <div class="stats-value">@ViewBag.TotalReviews</div>
                <div class="stats-label">Отзывов</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Quick actions -->
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header"><h5 class="mb-0">Быстрые действия</h5></div>
                <div class="card-body d-grid gap-2">
                    <a asp-action="Locations" class="btn btn-dark"><i class="fas fa-store me-1"></i>Мои заведения</a>
                    <a asp-action="Promotions" class="btn btn-outline-dark"><i class="fas fa-bullhorn me-1"></i>Акции</a>
                    <a asp-action="Reviews" class="btn btn-outline-dark"><i class="fas fa-comment-dots me-1"></i>Отзывы</a>
                </div>
            </div>
        </div>

        <!-- Recent reviews -->
        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-comment-dots"></i> Последние отзывы</h5>
                    <a asp-action="Reviews" class="btn btn-sm btn-outline-dark">Все</a>
                </div>
                <div class="card-body">
                    @if (reviews.Any())
                    {
                        foreach (var review in reviews.Take(5))
                        {
                            <div class="border-bottom py-2">
                                <div class="d-flex justify-content-between">
                                    <span class="fw-bold">@(review.User?.Name ?? "—")</span>
                                    <span class="rating-stars" style="font-size:0.75rem;">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <i class="fa-star @(i <= review.Rating ? "fas" : "far")"></i>
                                        }
                                    </span>
                                </div>
                                <p class="small text-muted mb-0">@(review.Text?.Length > 100 ? review.Text[..100] + "..." : review.Text)</p>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="fas fa-comment-dots fa-2x mb-2 d-block"></i>
                            <p>Отзывов пока нет</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
